index 0000000..8519be4
--- /dev/null
+++ b/datasets/heir.py
@@ -0,0 +1,167 @@
+# ------------------------------------------------------------------------
+# HEIR v1.0 dataset for RLIPv2 (HICO-DET-style fine-tuning loader).
+# Mirrors datasets/hico.py (HICODetection): same augmentations
+# (make_hico_transforms), same multi-label pair targets, same text-label
+# interface (target['obj_classes'], target['verb_classes']).
+# Differences to hico.py:
+#   * category ids are already contiguous (objects 0..436, person = 0;
+#     interactions 0..224, one per (verb, role) pair), so no id remapping;
+#   * sub_labels = 0 (= index of "person" in the object text list), i.e. the
+#     behaviour of upstream's --use_correct_subject_category_hico;
+#   * texts: object names and (verb, role) phrases, see heir_interaction_text().
+# ------------------------------------------------------------------------
+import json
+from pathlib import Path
+
+import numpy as np
+import torch
+import torch.utils.data
+from PIL import Image
+
+from datasets.hico import make_hico_transforms
+
+# Role -> phrase template.  RLIPv2 phrases HICO verbs as lower-case verb
+# phrases in which a preposition marks how the object takes part
+# ("ride", "sit on", "brush with", "hold").  HEIR interactions are
+# (verb, role) pairs, so the role is rendered as such a preposition.
+ROLE_TEMPLATES = {
+    'target': '{verb}',                   # hold (target)          -> "hold"
+    'instrument': '{verb} with',          # cut (instrument)       -> "cut with"
+    'support': '{verb} on',               # sit (support)          -> "sit on"
+    'source': '{verb} from',              # pour (source)          -> "pour from"
+    'destination': '{verb} to',           # hand_over (destination)-> "hand over to"
+    'constraint': '{verb} constrained by',  # restrain (constraint) -> "restrain constrained by"
+}
+
+
+def heir_interaction_text(verb, role):
+    return ROLE_TEMPLATES[role].format(verb=verb.replace('_', ' '))
+
+
+def load_heir_texts(classes_file):
+    with open(classes_file, 'r') as f:
+        classes = json.load(f)
+    object_text = [o.replace('_', ' ') for o in classes['objects']]
+    verb_text = [heir_interaction_text(v, r) for v, r in classes['interaction_verb_role']]
+    assert len(object_text) == 437 and len(verb_text) == 225
+    assert len(set(object_text)) == len(object_text), 'duplicate object texts'
+    assert len(set(verb_text)) == len(verb_text), 'duplicate interaction texts'
+    assert classes['person_id'] == 0 and object_text[0] == 'person'
+    return object_text, verb_text
+
+
+class HEIRDetection(torch.utils.data.Dataset):
+    def __init__(self, img_set, img_folder, anno_file, classes_file, transforms, num_queries):
+        self.img_set = img_set
+        self.img_folder = Path(img_folder)
+        with open(anno_file, 'r') as f:
+            self.annotations = json.load(f)
+        self._transforms = transforms
+        self.num_queries = num_queries
+        self.object_text, self.verb_text = load_heir_texts(classes_file)
+        self.num_verbs = len(self.verb_text)
+
+        if img_set == 'train':
+            # same sanity filter as hico.py
+            self.ids = []
+            for idx, img_anno in enumerate(self.annotations):
+                for hoi in img_anno['hoi_annotation']:
+                    if hoi['subject_id'] >= len(img_anno['annotations']) or hoi['object_id'] >= len(img_anno['annotations']):
+                        break
+                else:
+                    self.ids.append(idx)
+        else:
+            self.ids = list(range(len(self.annotations)))
+
+    def __len__(self):
+        return len(self.ids)
+
+    def __getitem__(self, idx):
+        img_anno = self.annotations[self.ids[idx]]
+        img = Image.open(self.img_folder / img_anno['file_name']).convert('RGB')
+        w, h = img.size
+
+        annos = img_anno['annotations']
+        if self.img_set == 'train' and len(annos) > self.num_queries:
+            annos = annos[:self.num_queries]
+
+        boxes = torch.as_tensor([obj['bbox'] for obj in annos], dtype=torch.float32).reshape(-1, 4)
+        target = {'orig_size': torch.as_tensor([int(h), int(w)]), 'size': torch.as_tensor([int(h), int(w)])}
+
+        if self.img_set == 'train':
+            classes = torch.tensor([(i, obj['category_id']) for i, obj in enumerate(annos)], dtype=torch.int64).reshape(-1, 2)
+            boxes[:, 0::2].clamp_(min=0, max=w)
+            boxes[:, 1::2].clamp_(min=0, max=h)
+            keep = (boxes[:, 3] > boxes[:, 1]) & (boxes[:, 2] > boxes[:, 0])
+            boxes = boxes[keep]
+            classes = classes[keep]
+            target['boxes'] = boxes
+            target['labels'] = classes
+            target['iscrowd'] = torch.zeros((boxes.shape[0],), dtype=torch.int64)
+            target['area'] = (boxes[:, 2] - boxes[:, 0]) * (boxes[:, 3] - boxes[:, 1])
+
+            if self._transforms is not None:
+                img, target = self._transforms(img, target)
+
+            kept_box_indices = [int(label[0]) for label in target['labels']]
+            target['labels'] = target['labels'][:, 1]
+
+            obj_labels, verb_labels, sub_boxes, obj_boxes = [], [], [], []
+            sub_obj_pairs = []
+            for hoi in img_anno['hoi_annotation']:
+                if hoi['subject_id'] not in kept_box_indices or hoi['object_id'] not in kept_box_indices:
+                    continue
+                pair = (hoi['subject_id'], hoi['object_id'])
+                if pair in sub_obj_pairs:
+                    verb_labels[sub_obj_pairs.index(pair)][hoi['category_id']] = 1
+                else:
+                    sub_obj_pairs.append(pair)
+                    obj_labels.append(target['labels'][kept_box_indices.index(hoi['object_id'])])
+                    verb_label = [0] * self.num_verbs
+                    verb_label[hoi['category_id']] = 1
+                    verb_labels.append(verb_label)
+                    sub_boxes.append(target['boxes'][kept_box_indices.index(hoi['subject_id'])])
+                    obj_boxes.append(target['boxes'][kept_box_indices.index(hoi['object_id'])])
+
+            target['filename'] = img_anno['file_name']
+            target['obj_classes'] = self.object_text
+            target['verb_classes'] = self.verb_text
+            if len(sub_obj_pairs) == 0:
+                target['obj_labels'] = torch.zeros((0,), dtype=torch.int64)
+                target['sub_labels'] = torch.zeros((0,), dtype=torch.int64)
+                target['verb_labels'] = torch.zeros((0, self.num_verbs), dtype=torch.float32)
+                target['sub_boxes'] = torch.zeros((0, 4), dtype=torch.float32)
+                target['obj_boxes'] = torch.zeros((0, 4), dtype=torch.float32)
+            else:
+                target['obj_labels'] = torch.stack(obj_labels)
+                target['sub_labels'] = torch.zeros((len(obj_labels),), dtype=torch.int64)  # person = 0
+                target['verb_labels'] = torch.as_tensor(verb_labels, dtype=torch.float32)
+                target['sub_boxes'] = torch.stack(sub_boxes)
+                target['obj_boxes'] = torch.stack(obj_boxes)
+        else:
+            target['filename'] = img_anno['file_name']
+            target['image_id'] = str(img_anno['image_id'])
+            target['boxes'] = boxes
+            target['labels'] = torch.tensor([obj['category_id'] for obj in annos], dtype=torch.int64)
+            target['id'] = idx
+            if self._transforms is not None:
+                img, _ = self._transforms(img, None)
+            target['hois'] = torch.as_tensor(
+                [(hoi['subject_id'], hoi['object_id'], hoi['category_id']) for hoi in img_anno['hoi_annotation']],
+                dtype=torch.int64).reshape(-1, 3)
+        return img, target
+
+
+def build(image_set, args):
+    root = Path(args.hoi_path)
+    assert root.exists(), f'provided HOI path {root} does not exist'
+    split = {'train': 'train', 'val': 'val', 'test': 'test'}[image_set]
+    anno_file = root / 'annotations' / f'{split}_heir.json'
+    print('HEIR {} anno file: {}'.format(image_set, anno_file))
+    dataset = HEIRDetection(image_set, root / 'images', anno_file, root / 'annotations' / 'classes.json',
+                            transforms=make_hico_transforms('train' if image_set == 'train' else 'val'),
+                            num_queries=args.num_queries)
+    if image_set != 'train':
+        # RLIPv2 HICO protocol: correct_mat indexed [verb, obj]
+        dataset.correct_mat = np.load(root / 'annotations' / 'corre_heir.npy').T.astype(np.float64)
+    return dataset
