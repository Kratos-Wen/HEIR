new file mode 100644
index 0000000..3b52d6a
--- /dev/null
+++ b/export_heir.py
@@ -0,0 +1,207 @@
+"""Export RLIPv2 (ParSeDA) predictions on HEIR val/test as JSONL for the shared HEIR scorer.
+
+Post-processing = RLIPv2's HICO-DET protocol (engine.evaluate_hoi_with_text ->
+PostProcessHOI -> datasets/hico_eval.HICOEvaluator):
+  * text embeddings of all object names (+ "no objects") and all interaction phrases;
+  * PostProcessHOI: obj score = max softmax over objects (no-object excluded),
+    interaction score = sigmoid(verb logit) * obj score; subject label = person (0);
+  * every (query, interaction) pair is a candidate; scores are multiplied by the
+    train co-occurrence mask correct_mat[interaction, object label] (corre_heir.npy);
+  * keep top-100 per image (HICOEvaluator.max_hois), then triplet (pairwise) NMS
+    (use_nms_filter, thres_nms 0.7, nms_alpha 1.0, nms_beta 0.5).
+A second file without the co-occurrence mask is written for reference (--also_nomask).
+
+Output line: {"image_id", "boxes" (original pixels, xyxy), "labels", "box_scores",
+"hois": [{"subject_id","object_id","category_id","score"}]}; one line per split image in
+split order; images beyond --limit are written with empty predictions.
+"""
+import argparse
+import json
+import os
+import sys
+import time
+from pathlib import Path
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+os.chdir(os.path.dirname(os.path.abspath(__file__)))  # upstream loads priors via relative paths
+
+import util.misc as utils  # noqa: E402
+from datasets import build_dataset  # noqa: E402
+from models import build_model  # noqa: E402
+
+
+def pairwise_nms(subs, objs, scores, thres, alpha, beta):
+    # verbatim logic of HICOEvaluator.pairwise_nms
+    sx1, sy1, sx2, sy2 = subs[:, 0], subs[:, 1], subs[:, 2], subs[:, 3]
+    ox1, oy1, ox2, oy2 = objs[:, 0], objs[:, 1], objs[:, 2], objs[:, 3]
+    sub_areas = (sx2 - sx1 + 1) * (sy2 - sy1 + 1)
+    obj_areas = (ox2 - ox1 + 1) * (oy2 - oy1 + 1)
+    order = scores.argsort()[::-1]
+    keep = []
+    while order.size > 0:
+        i = order[0]
+        keep.append(i)
+        sw = np.maximum(0.0, np.minimum(sx2[i], sx2[order[1:]]) - np.maximum(sx1[i], sx1[order[1:]]) + 1)
+        sh = np.maximum(0.0, np.minimum(sy2[i], sy2[order[1:]]) - np.maximum(sy1[i], sy1[order[1:]]) + 1)
+        sub_inter = sw * sh
+        sub_union = sub_areas[i] + sub_areas[order[1:]] - sub_inter
+        ow = np.maximum(0.0, np.minimum(ox2[i], ox2[order[1:]]) - np.maximum(ox1[i], ox1[order[1:]]) + 1)
+        oh = np.maximum(0.0, np.minimum(oy2[i], oy2[order[1:]]) - np.maximum(oy1[i], oy1[order[1:]]) + 1)
+        obj_inter = ow * oh
+        obj_union = obj_areas[i] + obj_areas[order[1:]] - obj_inter
+        ovr = np.power(sub_inter / sub_union, alpha) * np.power(obj_inter / obj_union, beta)
+        order = order[np.where(ovr <= thres)[0] + 1]
+    return keep
+
+
+def image_record(image_id, res, box_scores, correct_mat, args):
+    """res: PostProcessHOI output for one image (cpu tensors)."""
+    boxes = res['boxes'].numpy()
+    labels = res['labels'].numpy()
+    vs = res['verb_scores'].numpy().astype(np.float64)  # [Q, V]
+    sub_ids = res['sub_ids'].numpy()
+    obj_ids = res['obj_ids'].numpy()
+    Q, V = vs.shape
+    verb_labels = np.tile(np.arange(V), (Q, 1)).ravel()
+    s_ids = np.tile(sub_ids, (V, 1)).T.ravel()
+    o_ids = np.tile(obj_ids, (V, 1)).T.ravel()
+    scores = vs.ravel()
+    if correct_mat is not None:
+        scores = scores * correct_mat[verb_labels, labels[o_ids]]
+    order = np.argsort(-scores, kind='stable')[:args.max_hois]
+    s_ids, o_ids, verb_labels, scores = s_ids[order], o_ids[order], verb_labels[order], scores[order]
+    if args.use_nms_filter and len(order):
+        keep_all = []
+        trip = {}
+        for k in range(len(order)):
+            key = (labels[s_ids[k]], labels[o_ids[k]], verb_labels[k])
+            trip.setdefault(key, []).append(k)
+        for key, idx in trip.items():
+            idx = np.array(idx)
+            kk = pairwise_nms(boxes[s_ids[idx]], boxes[o_ids[idx]], scores[idx], args.thres_nms, args.nms_alpha, args.nms_beta)
+            keep_all.extend(idx[kk].tolist())
+        keep_all = sorted(keep_all)  # keep score order
+        s_ids, o_ids, verb_labels, scores = s_ids[keep_all], o_ids[keep_all], verb_labels[keep_all], scores[keep_all]
+    # compact: keep only referenced boxes
+    used = sorted(set(s_ids.tolist()) | set(o_ids.tolist()))
+    remap = {b: i for i, b in enumerate(used)}
+    return {
+        'image_id': image_id,
+        'boxes': [[round(float(x), 2) for x in boxes[b]] for b in used],
+        'labels': [int(labels[b]) for b in used],
+        'box_scores': [round(float(box_scores[b]), 6) for b in used],
+        'hois': [{'subject_id': remap[int(s)], 'object_id': remap[int(o)], 'category_id': int(v), 'score': float(sc)}
+                 for s, o, v, sc in zip(s_ids, o_ids, verb_labels, scores)],
+    }
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--checkpoint', required=True)
+    ap.add_argument('--split', choices=('val', 'test'), required=True)
+    ap.add_argument('--output', required=True)
+    ap.add_argument('--hoi_path', required=True)
+    ap.add_argument('--text_encoder_type', default=None)
+    ap.add_argument('--batch_size', type=int, default=4)
+    ap.add_argument('--num_workers', type=int, default=4)
+    ap.add_argument('--limit', type=int, default=0, help='only run the first N images (others empty)')
+    ap.add_argument('--max_hois', type=int, default=100, help='HICOEvaluator.max_hois')
+    ap.add_argument('--also_nomask', action='store_true')
+    ap.add_argument('--corre', default=None,
+                    help='override co-occurrence mask .npy, bool [437 objects, 225 interactions] (same layout as '
+                         'corre_heir.npy; transposed to [interaction, object] exactly like the default)')
+    a = ap.parse_args()
+
+    ckpt = torch.load(a.checkpoint, map_location='cpu', weights_only=False)
+    args = ckpt['args']
+    args.hoi_path = a.hoi_path
+    args.batch_size = a.batch_size
+    args.distributed = False
+    args.pretrained = ''
+    args.resume = ''
+    if a.text_encoder_type:
+        args.text_encoder_type = a.text_encoder_type
+    args.max_hois = a.max_hois
+    device = torch.device('cuda')
+    torch.manual_seed(args.seed)
+
+    model, _, postprocessors = build_model(args)
+    info = model.load_state_dict(ckpt['model'], strict=True)
+    print('load:', info, 'epoch', ckpt.get('epoch'))
+    model.to(device).eval()
+
+    ds = build_dataset(image_set=a.split, args=args)
+    n = len(ds) if not a.limit else min(a.limit, len(ds))
+    sub = torch.utils.data.Subset(ds, list(range(n)))
+    loader = torch.utils.data.DataLoader(sub, batch_size=a.batch_size, shuffle=False, drop_last=False,
+                                         collate_fn=utils.collate_fn, num_workers=a.num_workers)
+
+    tr = model.transformer
+    with torch.no_grad():
+        if args.use_no_obj_token:
+            sums = torch.tensor([[len(ds.object_text) + 1, len(ds.verb_text)]])
+            flat_text = ds.object_text + ['no objects'] + ds.verb_text
+        else:
+            sums = torch.tensor([[len(ds.object_text), len(ds.verb_text)]])
+            flat_text = ds.object_text + ds.verb_text
+        tok = tr.tokenizer.batch_encode_plus(flat_text, padding='longest', return_tensors='pt').to(device)
+        text_memory = tr.text_encoder(**tok).pooler_output
+        if not (args.fusion_type == 'GLIP_attn'):
+            text_memory = tr.resizer(text_memory)
+
+    correct_mat = ds.correct_mat
+    if a.corre:
+        m = np.load(a.corre)
+        assert m.shape == (len(ds.object_text), len(ds.verb_text)), m.shape
+        correct_mat = m.T.astype(np.float64)
+        print('co-occurrence mask:', a.corre, 'allowed pairs:', int(m.sum()))
+    records = {'mask': [], 'nomask': []}
+    t0 = time.time()
+    with torch.no_grad():
+        for bi, (samples, targets) in enumerate(loader):
+            samples = samples.to(device)
+            bs = samples.tensors.shape[0]
+            mem = text_memory.unsqueeze(1).repeat(1, bs, 1)
+            mask = torch.zeros(mem.shape[:2], device=device).bool()
+            kwargs = {'text': (mask, mem, sums)}
+            memory_cache = model(samples, encode_and_save=True, **kwargs)
+            outputs = model(samples, encode_and_save=False, memory_cache=memory_cache, **kwargs)
+            if outputs['pred_verb_logits'].shape[2] == len(ds.verb_text) + 1:
+                outputs['pred_verb_logits'] = outputs['pred_verb_logits'][:, :, :-1]
+            orig_sizes = torch.stack([t['orig_size'] for t in targets]).to(device)
+            results = postprocessors['hoi'](outputs, orig_sizes)
+            obj_scores = F.softmax(outputs['pred_obj_logits'], -1)[..., :-1].max(-1)[0].cpu()
+            if 'pred_sub_logits' in outputs:
+                sub_scores = F.softmax(outputs['pred_sub_logits'], -1)[..., args.subject_category_id].cpu()
+            else:
+                sub_scores = torch.ones_like(obj_scores)
+            for t, res, osc, ssc in zip(targets, results, obj_scores, sub_scores):
+                box_scores = torch.cat([ssc, osc]).numpy()
+                records['mask'].append(image_record(t['image_id'], res, box_scores, correct_mat, args))
+                if a.also_nomask:
+                    records['nomask'].append(image_record(t['image_id'], res, box_scores, None, args))
+            if bi % 100 == 0:
+                print(f'[{a.split}] {bi * a.batch_size}/{n} images, {time.time() - t0:.1f}s', flush=True)
+
+    all_ids = [str(x['image_id']) for x in ds.annotations]
+    for kind, recs in records.items():
+        if kind == 'nomask' and not a.also_nomask:
+            continue
+        out = Path(a.output) if kind == 'mask' else Path(str(a.output).replace('.jsonl', '_nomask.jsonl'))
+        out.parent.mkdir(parents=True, exist_ok=True)
+        assert [r['image_id'] for r in recs] == all_ids[:n]
+        with open(out, 'w') as f:
+            for r in recs:
+                f.write(json.dumps(r) + '\n')
+            for iid in all_ids[n:]:
+                f.write(json.dumps({'image_id': iid, 'boxes': [], 'labels': [], 'box_scores': [], 'hois': []}) + '\n')
+        print('wrote', out, len(all_ids), 'lines;', n, 'with predictions')
+    print(f'export done in {time.time() - t0:.1f}s ({n / max(1e-6, time.time() - t0):.2f} img/s)')
+
+
+if __name__ == '__main__':
+    main()
