{
  "assets": {
    "GEN_VLKT_L_CLIP_MODEL": {
      "mounts": [
        [
          "assets/gen_vlkt_l_clip_model/ViT-B-32.pt",
          ""
        ]
      ]
    },
    "GEN_VLKT_L_PARAM_PATH": {
      "mounts": [
        [
          "assets/gen_vlkt_l_param_path/VCOCO_GEN_VLKT_L.pth",
          ""
        ]
      ]
    },
    "GEN_VLKT_S_CLIP_MODEL": {
      "mounts": [
        [
          "assets/gen_vlkt_s_clip_model/ViT-B-32.pt",
          ""
        ]
      ]
    },
    "GEN_VLKT_S_PARAM_PATH": {
      "mounts": [
        [
          "assets/gen_vlkt_s_param_path/VCOCO_GEN_VLKT_S.pth",
          ""
        ]
      ]
    },
    "VCOCO": {
      "mounts": [
        [
          "data/v-coco",
          ""
        ]
      ]
    }
  },
  "commands": {
    "sources": {
      "argv": [
        "{python}",
        "{root}/workspace/fetch_sources.py"
      ],
      "assets": [],
      "cwd": "{root}/workspace",
      "distributed": false,
      "run_name": "sources",
      "world_size": 1,
      "pythonpath": [
        "workspace"
      ]
    },
    "gen_vlkt_l-infer": {
      "argv": [
        "{python}",
        "generate_vcoco_official.py",
        "--param_path",
        "{root}/assets/gen_vlkt_l_param_path/VCOCO_GEN_VLKT_L.pth",
        "--save_path",
        "{output}/predictions.pkl",
        "--hoi_path",
        "{root}/data/v-coco",
        "--batch_size",
        "1",
        "--num_workers",
        "2",
        "--backbone",
        "resnet101",
        "--num_queries",
        "64",
        "--dec_layers",
        "6",
        "--use_nms_filter",
        "--with_clip_label",
        "--with_obj_clip_label",
        "--clip_model",
        "{root}/assets/gen_vlkt_l_clip_model/ViT-B-32.pt"
      ],
      "assets": [
        "VCOCO",
        "GEN_VLKT_L_PARAM_PATH",
        "GEN_VLKT_L_CLIP_MODEL"
      ],
      "cwd": "{root}/workspace/reference_repos/gen-vlkt",
      "distributed": false,
      "run_name": "gen_vlkt_l",
      "world_size": 1
    },
    "gen_vlkt_l-score": {
      "argv": [
        "{python}",
        "{repo}/evaluation/evaluate_vcoco_official.py",
        "--cache",
        "{output}/predictions.pkl",
        "--vsrl-json",
        "{root}/data/v-coco/data/vcoco/vcoco_test.json",
        "--coco-json",
        "{root}/data/v-coco/data/instances_vcoco_all_2014.json",
        "--split-ids",
        "{root}/data/v-coco/data/splits/vcoco_test.ids",
        "--evaluator",
        "{root}/data/v-coco/vsrl_eval.py",
        "--output-json",
        "{output}/official_metrics.json",
        "--agent-ap"
      ],
      "assets": [
        "VCOCO"
      ],
      "cwd": "{root}/workspace",
      "distributed": false,
      "run_name": "gen_vlkt_l",
      "world_size": 1
    },
    "gen_vlkt_s-infer": {
      "argv": [
        "{python}",
        "generate_vcoco_official.py",
        "--param_path",
        "{root}/assets/gen_vlkt_s_param_path/VCOCO_GEN_VLKT_S.pth",
        "--save_path",
        "{output}/predictions.pkl",
        "--hoi_path",
        "{root}/data/v-coco",
        "--batch_size",
        "1",
        "--num_workers",
        "2",
        "--backbone",
        "resnet50",
        "--num_queries",
        "64",
        "--dec_layers",
        "3",
        "--use_nms_filter",
        "--with_clip_label",
        "--with_obj_clip_label",
        "--clip_model",
        "{root}/assets/gen_vlkt_s_clip_model/ViT-B-32.pt"
      ],
      "assets": [
        "VCOCO",
        "GEN_VLKT_S_PARAM_PATH",
        "GEN_VLKT_S_CLIP_MODEL"
      ],
      "cwd": "{root}/workspace/reference_repos/gen-vlkt",
      "distributed": false,
      "run_name": "gen_vlkt_s",
      "world_size": 1
    },
    "gen_vlkt_s-score": {
      "argv": [
        "{python}",
        "{repo}/evaluation/evaluate_vcoco_official.py",
        "--cache",
        "{output}/predictions.pkl",
        "--vsrl-json",
        "{root}/data/v-coco/data/vcoco/vcoco_test.json",
        "--coco-json",
        "{root}/data/v-coco/data/instances_vcoco_all_2014.json",
        "--split-ids",
        "{root}/data/v-coco/data/splits/vcoco_test.ids",
        "--evaluator",
        "{root}/data/v-coco/vsrl_eval.py",
        "--output-json",
        "{output}/official_metrics.json",
        "--agent-ap"
      ],
      "assets": [
        "VCOCO"
      ],
      "cwd": "{root}/workspace",
      "distributed": false,
      "run_name": "gen_vlkt_s",
      "world_size": 1
    }
  },
  "family": "gen-vlkt"
}
