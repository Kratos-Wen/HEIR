diff --git a/tools/export_heir_predictions.py b/tools/export_heir_predictions.py
new file mode 100644
index 0000000..8ef1487
--- /dev/null
+++ b/tools/export_heir_predictions.py
@@ -0,0 +1,144 @@
+"""Export GEN-VLKT predictions on HEIR val/test as JSONL for common/evaluate_heir_predictions.py.
+
+Post-processing = GEN-VLKT's HICO evaluation (datasets/hico_eval_triplet.py, --use_nms_filter):
+  PostProcessHOITriplet -> per query q: sub box, obj box (original pixels), sigmoid triplet logits hoi[q, t],
+  sigmoid object logits obj[q, c];  score(q, t) = hoi[q, t] + obj[q, obj(t)]^2  (exactly HICOEvaluator)
+  -> top-100 (q, t) per image -> pairwise triplet NMS (thres 0.7, alpha 1, beta 0.5).
+Mapping to HEIR: triplet t = (interaction id, object id) -> hoi category_id = interaction id; the object entity is
+the query's object box labelled with the triplet's object class (one node per (query, object class) used), the
+subject entity is the query's subject box labelled person.  The HEIR scorer needs scores in [0, 1], so the exported
+score is score / 2 (monotone: identical ranking and AP).
+Entity box_scores: object node = obj[q, c]; subject node = 1.0 (GEN-VLKT has no subject classifier).
+"""
+import argparse
+import json
+import sys
+from pathlib import Path
+
+import numpy as np
+import torch
+from torch.utils.data import DataLoader, SequentialSampler, Subset
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+import util.misc as utils  # noqa: E402
+from datasets import build_dataset  # noqa: E402
+from datasets.heir_labels import get_heir_labels  # noqa: E402
+from models import build_model  # noqa: E402
+
+MAX_HOIS, THRES_NMS, NMS_ALPHA, NMS_BETA = 100, 0.7, 1.0, 0.5
+
+
+def pairwise_nms(subs, objs, scores):
+    """Copied from HICOEvaluator.pairwise_nms (GEN-VLKT)."""
+    sx1, sy1, sx2, sy2 = subs[:, 0], subs[:, 1], subs[:, 2], subs[:, 3]
+    ox1, oy1, ox2, oy2 = objs[:, 0], objs[:, 1], objs[:, 2], objs[:, 3]
+    sub_areas = (sx2 - sx1 + 1) * (sy2 - sy1 + 1)
+    obj_areas = (ox2 - ox1 + 1) * (oy2 - oy1 + 1)
+    order = scores.argsort()[::-1]
+    keep = []
+    while order.size > 0:
+        i = order[0]
+        keep.append(i)
+        sw = np.maximum(0.0, np.minimum(sx2[i], sx2[order[1:]]) - np.maximum(sx1[i], sx1[order[1:]]) + 1)
+        sh = np.maximum(0.0, np.minimum(sy2[i], sy2[order[1:]]) - np.maximum(sy1[i], sy1[order[1:]]) + 1)
+        si = sw * sh
+        ow = np.maximum(0.0, np.minimum(ox2[i], ox2[order[1:]]) - np.maximum(ox1[i], ox1[order[1:]]) + 1)
+        oh = np.maximum(0.0, np.minimum(oy2[i], oy2[order[1:]]) - np.maximum(oy1[i], oy1[order[1:]]) + 1)
+        oi = ow * oh
+        ovr = np.power(si / (sub_areas[i] + sub_areas[order[1:]] - si), NMS_ALPHA) * \
+            np.power(oi / (obj_areas[i] + obj_areas[order[1:]] - oi), NMS_BETA)
+        order = order[np.where(ovr <= THRES_NMS)[0] + 1]
+    return keep
+
+
+def image_record(image_id, res, trip_inter, trip_obj):
+    hoi = res['hoi_scores'].numpy()          # [Q, T]
+    obj = res['obj_scores'].numpy()          # [Q, C+1]
+    boxes = res['boxes'].numpy()             # [2Q, 4]: subjects then objects
+    nq = hoi.shape[0]
+    score = hoi + (obj * obj)[:, trip_obj]
+    flat = score.ravel()
+    top = np.argsort(-flat, kind='stable')[:MAX_HOIS]
+    q_idx, t_idx = top // score.shape[1], top % score.shape[1]
+    s_top = flat[top]
+    # triplet NMS (per triplet class), as GEN-VLKT with --use_nms_filter
+    keep_all = []
+    for t in np.unique(t_idx):
+        m = np.where(t_idx == t)[0]
+        k = pairwise_nms(boxes[q_idx[m]], boxes[nq + q_idx[m]], s_top[m])
+        keep_all.extend(m[k].tolist())
+    keep_all = sorted(keep_all, key=lambda i: -s_top[i])
+    out_boxes, labels, box_scores, node, hois = [], [], [], {}, []
+
+    def get_node(key, box, label, bscore):
+        if key not in node:
+            node[key] = len(out_boxes)
+            out_boxes.append([round(float(v), 2) for v in box])
+            labels.append(int(label))
+            box_scores.append(float(min(1.0, max(0.0, bscore))))
+        return node[key]
+
+    for i in keep_all:
+        q, t = int(q_idx[i]), int(t_idx[i])
+        c = int(trip_obj[t])
+        sid = get_node(('s', q), boxes[q], 0, 1.0)
+        oid = get_node(('o', q, c), boxes[nq + q], c, obj[q, c])
+        hois.append({'subject_id': sid, 'object_id': oid, 'category_id': int(trip_inter[t]),
+                     'score': float(min(1.0, s_top[i] / 2.0))})
+    return {'image_id': image_id, 'boxes': out_boxes, 'labels': labels, 'box_scores': box_scores, 'hois': hois}
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--checkpoint', required=True)
+    ap.add_argument('--split', choices=('val', 'test'), required=True)
+    ap.add_argument('--output', required=True)
+    ap.add_argument('--hoi_path', required=True)
+    ap.add_argument('--clip_model', default=None, help='override path of CLIP ViT-B/32 .pt')
+    ap.add_argument('--limit', type=int, default=-1, help='only run the first N images; the rest get empty hois')
+    ap.add_argument('--batch_size', type=int, default=8)
+    ap.add_argument('--num_workers', type=int, default=4)
+    a = ap.parse_args()
+
+    ckpt = torch.load(a.checkpoint, map_location='cpu', weights_only=False)
+    args = ckpt['args']
+    args.distributed, args.eval, args.hoi_path = False, True, a.hoi_path
+    if a.clip_model:
+        args.clip_model = a.clip_model
+    args.device = 'cuda'
+    model, _, postprocessors = build_model(args)
+    model.load_state_dict(ckpt['model'])
+    model.to('cuda').eval()
+
+    dataset = build_dataset(image_set=a.split, args=args)
+    n = len(dataset) if a.limit < 0 else min(a.limit, len(dataset))
+    loader = DataLoader(Subset(dataset, list(range(n))), a.batch_size, sampler=SequentialSampler(range(n)),
+                        collate_fn=utils.collate_fn, num_workers=a.num_workers)
+    keys = list(get_heir_labels(args)[0].keys())
+    trip_inter = np.array([k[0] for k in keys])
+    trip_obj = np.array([k[1] for k in keys])
+    records, done = [], 0
+    with torch.no_grad():
+        for samples, targets in loader:
+            outputs = model(samples.to('cuda'), is_training=False)
+            sizes = torch.stack([t['orig_size'] for t in targets]).to('cuda')
+            results = postprocessors['hoi'](outputs, sizes)
+            for t, r in zip(targets, results):
+                image_id = dataset.annotations[int(t['id'])]['image_id']
+                records.append(image_record(image_id, r, trip_inter, trip_obj))
+            done += len(targets)
+            if done % 400 < a.batch_size:
+                print(f'{done}/{n}', flush=True)
+    for img in dataset.annotations[n:]:
+        records.append({'image_id': img['image_id'], 'boxes': [], 'labels': [], 'box_scores': [], 'hois': []})
+    assert [r['image_id'] for r in records] == [img['image_id'] for img in dataset.annotations]
+    Path(a.output).parent.mkdir(parents=True, exist_ok=True)
+    with open(a.output, 'w') as f:
+        for r in records:
+            f.write(json.dumps(r) + '\n')
+    print('wrote', a.output, len(records), 'images;', n, 'with predictions;',
+          sum(len(r['hois']) for r in records), 'hois')
+
+
+if __name__ == '__main__':
+    main()
