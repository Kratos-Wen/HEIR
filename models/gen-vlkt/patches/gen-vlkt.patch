diff --git a/datasets/heir.py b/datasets/heir.py
new file mode 100644
index 0000000..cd0329a
--- /dev/null
+++ b/datasets/heir.py
@@ -0,0 +1,142 @@
+"""HEIR v1.0 dataset for GEN-VLKT (mirror of datasets/hico.py).
+
+Annotations: data/heir_hico/annotations/{train,val,test}_heir.json (HICO-DET/PPDM layout, but object ids are
+contiguous 0..436 with person = 0 and hoi category_id is the contiguous interaction id 0..224 = one (verb, role)).
+Targets per (subject, object) pair are multi-label over the GEN-VLKT triplet classes
+(heir_text_label keys = (interaction id, object id) seen in train), exactly as the HICO loader does it.
+"""
+from pathlib import Path
+import json
+
+import numpy as np
+import torch
+import torch.utils.data
+from PIL import Image
+from clip.clip import _transform as clip_transform
+
+import datasets.transforms as T
+from .heir_labels import get_heir_labels
+from .hico import make_hico_transforms
+
+NUM_OBJ = 437
+NUM_INTER = 225
+
+
+class HEIRDetection(torch.utils.data.Dataset):
+    def __init__(self, img_set, img_folder, anno_file, transforms, num_queries, args):
+        self.img_set = img_set
+        self.img_folder = img_folder
+        with open(anno_file, 'r') as f:
+            self.annotations = json.load(f)
+        self._transforms = transforms
+        self.num_queries = num_queries
+        self.text_label_ids = list(get_heir_labels(args)[0].keys())
+        self.text_label_index = {k: i for i, k in enumerate(self.text_label_ids)}
+
+        if img_set == 'train':
+            self.ids = []
+            for idx, img_anno in enumerate(self.annotations):
+                ok = len(img_anno['hoi_annotation']) > 0 and all(
+                    h['subject_id'] < len(img_anno['annotations']) and h['object_id'] < len(img_anno['annotations'])
+                    for h in img_anno['hoi_annotation'])
+                if ok:
+                    self.ids.append(idx)
+        else:
+            self.ids = list(range(len(self.annotations)))
+        print("HEIR {} contains {} images".format(img_set, len(self.ids)))
+        # Same preprocessing as clip.load(...)[1] for ViT-B/32 (224 px) without loading the model per dataset.
+        self.clip_preprocess = clip_transform(224)
+
+    def __len__(self):
+        return len(self.ids)
+
+    def __getitem__(self, idx):
+        img_anno = self.annotations[self.ids[idx]]
+        img = Image.open(self.img_folder / img_anno['file_name']).convert('RGB')
+        w, h = img.size
+
+        annos = img_anno['annotations']
+        if self.img_set == 'train' and len(annos) > self.num_queries:
+            annos = annos[:self.num_queries]  # same truncation as GEN-VLKT's HICO loader
+
+        boxes = torch.as_tensor([o['bbox'] for o in annos], dtype=torch.float32).reshape(-1, 4)
+        if self.img_set == 'train':
+            classes = torch.tensor([(i, o['category_id']) for i, o in enumerate(annos)], dtype=torch.int64).reshape(-1, 2)
+        else:
+            classes = torch.tensor([o['category_id'] for o in annos], dtype=torch.int64)
+
+        target = {'orig_size': torch.as_tensor([int(h), int(w)]), 'size': torch.as_tensor([int(h), int(w)])}
+        if self.img_set == 'train':
+            boxes[:, 0::2].clamp_(min=0, max=w)
+            boxes[:, 1::2].clamp_(min=0, max=h)
+            keep = (boxes[:, 3] > boxes[:, 1]) & (boxes[:, 2] > boxes[:, 0])
+            boxes, classes = boxes[keep], classes[keep]
+            target['boxes'] = boxes
+            target['labels'] = classes
+            target['iscrowd'] = torch.zeros(boxes.shape[0], dtype=torch.int64)
+            target['area'] = (boxes[:, 2] - boxes[:, 0]) * (boxes[:, 3] - boxes[:, 1])
+
+            img_0, target_0 = self._transforms[0](img, target)
+            img, target = self._transforms[1](img_0, target_0)
+            target['clip_inputs'] = self.clip_preprocess(img_0)
+            kept_box_indices = [int(l[0]) for l in target['labels']]
+            target['labels'] = target['labels'][:, 1]
+
+            obj_labels, verb_labels, hoi_labels, sub_boxes, obj_boxes, pairs = [], [], [], [], [], []
+            for hoi in img_anno['hoi_annotation']:
+                if hoi['subject_id'] not in kept_box_indices or hoi['object_id'] not in kept_box_indices:
+                    continue
+                oi = kept_box_indices.index(hoi['object_id'])
+                trip = (hoi['category_id'], int(target['labels'][oi]))
+                if trip not in self.text_label_index:
+                    continue
+                pair = (hoi['subject_id'], hoi['object_id'])
+                if pair in pairs:
+                    k = pairs.index(pair)
+                else:
+                    pairs.append(pair)
+                    k = len(pairs) - 1
+                    obj_labels.append(target['labels'][oi])
+                    verb_labels.append([0.0] * NUM_INTER)
+                    hoi_labels.append([0.0] * len(self.text_label_ids))
+                    sub_boxes.append(target['boxes'][kept_box_indices.index(hoi['subject_id'])])
+                    obj_boxes.append(target['boxes'][oi])
+                verb_labels[k][hoi['category_id']] = 1.0
+                hoi_labels[k][self.text_label_index[trip]] = 1.0
+
+            target['filename'] = img_anno['file_name']
+            if len(pairs) == 0:
+                target['obj_labels'] = torch.zeros((0,), dtype=torch.int64)
+                target['verb_labels'] = torch.zeros((0, NUM_INTER), dtype=torch.float32)
+                target['hoi_labels'] = torch.zeros((0, len(self.text_label_ids)), dtype=torch.float32)
+                target['sub_boxes'] = torch.zeros((0, 4), dtype=torch.float32)
+                target['obj_boxes'] = torch.zeros((0, 4), dtype=torch.float32)
+            else:
+                target['obj_labels'] = torch.stack(obj_labels)
+                target['verb_labels'] = torch.as_tensor(verb_labels, dtype=torch.float32)
+                target['hoi_labels'] = torch.as_tensor(hoi_labels, dtype=torch.float32)
+                target['sub_boxes'] = torch.stack(sub_boxes)
+                target['obj_boxes'] = torch.stack(obj_boxes)
+        else:
+            target['filename'] = img_anno['file_name']
+            target['boxes'] = boxes
+            target['labels'] = classes
+            target['id'] = idx
+            img, _ = self._transforms(img, None)
+            hois = [(h['subject_id'], h['object_id'], h['category_id']) for h in img_anno['hoi_annotation']]
+            target['hois'] = torch.as_tensor(hois, dtype=torch.int64).reshape(-1, 3)
+        return img, target
+
+    def load_correct_mat(self, path):
+        self.correct_mat = np.load(path)  # bool [437 objects, 225 interactions]
+
+
+def build(image_set, args):
+    root = Path(args.hoi_path)
+    assert root.exists(), f'provided HOI path {root} does not exist'
+    anno = {'train': 'train_heir.json', 'val': 'val_heir.json', 'test': 'test_heir.json'}[image_set]
+    dataset = HEIRDetection(image_set, root / 'images', root / 'annotations' / anno,
+                            transforms=make_hico_transforms('train' if image_set == 'train' else 'val'),
+                            num_queries=args.num_queries, args=args)
+    dataset.load_correct_mat(root / 'annotations' / 'corre_heir.npy')
+    return dataset
