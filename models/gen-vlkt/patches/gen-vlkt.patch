+"""Select the HEIR GEN-VLKT triplet/object text labels.
+'train'    : datasets/heir_text_label.py          (train co-occurrence triplets)
+'sem10072' : datasets/heir_text_label_sem10072.py (9764 representable triplets of the 10,072 semantic inventory)
+"""
+import importlib
+
+_MODULES = {'train': 'datasets.heir_text_label', 'sem10072': 'datasets.heir_text_label_sem10072'}
+
+
+def get_heir_labels(args_or_name):
+    name = args_or_name if isinstance(args_or_name, str) else getattr(args_or_name, 'heir_label_set', 'train')
+    m = importlib.import_module(_MODULES[name])
+    return m.heir_text_label, m.heir_obj_text_label
