{
  "assets": {
    "SOV_STG_L_RESUME": {
      "mounts": [
        [
          "assets/sov_stg_l_resume/sov-stg-l_vcoco.pth",
          ""
        ]
      ]
    },
    "SOV_STG_VLA_S_RESUME": {
      "mounts": [
        [
          "assets/sov_stg_vla_s_resume/SOV_STG_VLA_vcoco_s.pth",
          ""
        ]
      ]
    },
    "VCOCO": {
      "mounts": [
        [
          "data/v-coco",
          ""
        ]
      ]
    }
  },
  "commands": {
    "sources": {
      "argv": [
        "{python}",
        "{root}/workspace/fetch_sources.py"
      ],
      "assets": [],
      "cwd": "{root}/workspace",
      "distributed": false,
      "run_name": "sources",
      "world_size": 1,
      "pythonpath": [
        "workspace"
      ]
    },
    "sov_stg_l-infer": {
      "argv": [
        "{python}",
        "generate_vcoco_official.py",
        "-c",
        "slconfig/vcoco-sov-stg-l.py",
        "--resume",
        "{root}/assets/sov_stg_l_resume/sov-stg-l_vcoco.pth",
        "--dataset_file",
        "vcoco",
        "--hoi_path",
        "{root}/data/v-coco",
        "--num_obj_classes",
        "81",
        "--num_verb_classes",
        "29",
        "--output_dir",
        "{output}",
        "--batch_size",
        "1",
        "--num_workers",
        "2",
        "--eval"
      ],
      "assets": [
        "VCOCO",
        "SOV_STG_L_RESUME"
      ],
      "cwd": "{root}/workspace/reference_repos/SOV-STG",
      "distributed": false,
      "run_name": "sov_stg_l",
      "world_size": 1
    },
    "sov_stg_l-score": {
      "argv": [
        "{python}",
        "{repo}/evaluation/evaluate_vcoco_official.py",
        "--cache",
        "{output}/vcoco.pickle",
        "--vsrl-json",
        "{root}/data/v-coco/data/vcoco/vcoco_test.json",
        "--coco-json",
        "{root}/data/v-coco/data/instances_vcoco_all_2014.json",
        "--split-ids",
        "{root}/data/v-coco/data/splits/vcoco_test.ids",
        "--evaluator",
        "{root}/data/v-coco/vsrl_eval.py",
        "--output-json",
        "{output}/official_metrics.json",
        "--agent-ap"
      ],
      "assets": [
        "VCOCO"
      ],
      "cwd": "{root}/workspace",
      "distributed": false,
      "run_name": "sov_stg_l",
      "world_size": 1
    },
    "sov_stg_vla_s-infer": {
      "argv": [
        "{python}",
        "generate_vcoco_official.py",
        "-c",
        "slconfig/vcoco_sov-stg-s-vla-blip2_hoi.py",
        "--resume",
        "{root}/assets/sov_stg_vla_s_resume/SOV_STG_VLA_vcoco_s.pth",
        "--dataset_file",
        "vcoco",
        "--hoi_path",
        "{root}/data/v-coco",
        "--num_obj_classes",
        "81",
        "--num_verb_classes",
        "29",
        "--output_dir",
        "{output}",
        "--batch_size",
        "1",
        "--num_workers",
        "2",
        "--eval",
        "--with_clip_label",
        "--fix_clip",
        "--zero_shot_type",
        "default"
      ],
      "assets": [
        "VCOCO",
        "SOV_STG_VLA_S_RESUME"
      ],
      "cwd": "{root}/workspace/reference_repos/SOV-STG-VLA",
      "distributed": false,
      "run_name": "sov_stg_vla_s",
      "world_size": 1
    },
    "sov_stg_vla_s-score": {
      "argv": [
        "{python}",
        "{repo}/evaluation/evaluate_vcoco_official.py",
        "--cache",
        "{output}/vcoco.pickle",
        "--vsrl-json",
        "{root}/data/v-coco/data/vcoco/vcoco_test.json",
        "--coco-json",
        "{root}/data/v-coco/data/instances_vcoco_all_2014.json",
        "--split-ids",
        "{root}/data/v-coco/data/splits/vcoco_test.ids",
        "--evaluator",
        "{root}/data/v-coco/vsrl_eval.py",
        "--output-json",
        "{output}/official_metrics.json",
        "--agent-ap"
      ],
      "assets": [
        "VCOCO"
      ],
      "cwd": "{root}/workspace",
      "distributed": false,
      "run_name": "sov_stg_vla_s",
      "world_size": 1
    }
  },
  "family": "sov-stg"
}
