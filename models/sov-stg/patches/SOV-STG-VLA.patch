diff --git a/tools/build_heir_text_labels.py b/tools/build_heir_text_labels.py
new file mode 100644
index 0000000..3a56ffb
--- /dev/null
+++ b/tools/build_heir_text_labels.py
@@ -0,0 +1,126 @@
+"""Build GEN-VLKT text labels for HEIR v1.0 (analogue of datasets/hico_text_label.py).
+
+Triplets = every (interaction, object) combination that occurs in train_heir.json
+(HICO's 600-triplet analogue). Checked to equal the nonzero entries of corre_heir.npy.
+Combinations that never occur in train do not exist as classifier rows.
+
+Prompt template (GEN-VLKT style "a photo of a person <verb-ing> <a/an object>", extended with the role):
+  target      : a photo of a person {ving} {a obj}
+  instrument  : a photo of a person {ving} using {a obj} as instrument
+  support     : a photo of a person {ving} on {a obj} as support
+  source      : a photo of a person {ving} from {a obj} as source
+  destination : a photo of a person {ving} to {a obj} as destination
+  constraint  : a photo of a person {ving} with {a obj} as constraint
+{ving} = gerund (+ target-only preposition for a few verbs, e.g. "looking at", as HICO does);
+{obj}  = HEIR noun id with '_' -> ' '.
+Object prompts: "a photo of {a obj}" for the 437 objects + "a photo of nothing" (no-object class).
+
+Writes datasets/heir_text_label.py.
+
+Semantic-inventory protocol (--corre .../semantic10072/corre_semantic10072.npy --out datasets/heir_text_label_sem10072.py):
+triplets = the nonzero (object, interaction) entries of the given corre matrix (9,764 representable combinations of the
+10,072-triple dataset-level inventory), including combinations without train positives (like HICO's 600 in the
+zero-shot settings); every train triplet must be inside it.
+"""
+import argparse
+import json
+from collections import OrderedDict
+from pathlib import Path
+
+import numpy as np
+
+ROOT = Path(__import__('os').environ.get('HEIR_HICO_ANNOTATIONS', 'data/heir_hico/annotations'))
+OUT = Path(__file__).resolve().parents[1] / 'datasets' / 'heir_text_label.py'
+
+GERUND = {
+    'applaud': 'applauding', 'assist': 'assisting', 'attach': 'attaching', 'block': 'blocking', 'blow': 'blowing',
+    'brush': 'brushing', 'carry': 'carrying', 'catch': 'catching', 'climb': 'climbing', 'close': 'closing',
+    'cover': 'covering', 'cut': 'cutting', 'defibrillate': 'defibrillating', 'dig': 'digging', 'draw': 'drawing',
+    'dribble': 'dribbling', 'drill': 'drilling', 'drink': 'drinking', 'drive': 'driving', 'eat': 'eating',
+    'enter': 'entering', 'exit': 'exiting', 'fasten': 'fastening', 'feed': 'feeding', 'fold': 'folding',
+    'grasp': 'grasping', 'grind': 'grinding', 'guide': 'guiding', 'hammer': 'hammering', 'hand_over': 'handing over',
+    'high_five': 'high-fiving', 'hit': 'hitting', 'hold': 'holding', 'hug': 'hugging', 'ignite': 'igniting',
+    'inject': 'injecting', 'insert': 'inserting', 'inspect': 'inspecting', 'jump': 'jumping', 'kick': 'kicking',
+    'kiss': 'kissing', 'lean': 'leaning', 'lick': 'licking', 'lie': 'lying', 'lift': 'lifting', 'listen': 'listening',
+    'look': 'looking', 'measure': 'measuring', 'open': 'opening', 'paint': 'painting', 'peel': 'peeling',
+    'photograph': 'photographing', 'pipette': 'pipetting', 'place': 'placing', 'play': 'playing', 'plug': 'plugging',
+    'point': 'pointing', 'pour': 'pouring', 'press': 'pressing', 'pull': 'pulling', 'push': 'pushing',
+    'put_on': 'putting on', 'reach': 'reaching', 'read': 'reading', 'record': 'recording', 'remove': 'removing',
+    'restrain': 'restraining', 'ride': 'riding', 'rotate': 'rotating', 'row': 'rowing', 'sand': 'sanding',
+    'saw': 'sawing', 'scoop': 'scooping', 'scrape': 'scraping', 'shake_hands': 'shaking hands', 'show': 'showing',
+    'signal': 'signaling', 'sit': 'sitting', 'slide': 'sliding', 'smell': 'smelling', 'smoke': 'smoking',
+    'solder': 'soldering', 'spray': 'spraying', 'spread': 'spreading', 'squeeze': 'squeezing', 'stack': 'stacking',
+    'stand': 'standing', 'stir': 'stirring', 'straddle': 'straddling', 'sweep': 'sweeping', 'swing': 'swinging',
+    'swipe': 'swiping', 'take_off': 'taking off', 'talk': 'talking', 'throw': 'throwing', 'touch': 'touching',
+    'turn': 'turning', 'type': 'typing', 'unfold': 'unfolding', 'wash': 'washing', 'wear': 'wearing',
+    'weld': 'welding', 'wipe': 'wiping', 'wrap': 'wrapping', 'write': 'writing',
+}
+# Intransitive verbs need a preposition before the target (HICO does the same, e.g. "looking at").
+TARGET_PREP = {'listen': 'to', 'look': 'at', 'point': 'at', 'signal': 'to', 'talk': 'to', 'reach': 'for',
+               'shake_hands': 'with', 'high_five': '', 'applaud': ''}
+ROLE_TEMPLATE = {
+    'target': 'a photo of a person {ving} {obj}',
+    'instrument': 'a photo of a person {ving} using {obj} as instrument',
+    'support': 'a photo of a person {ving} on {obj} as support',
+    'source': 'a photo of a person {ving} from {obj} as source',
+    'destination': 'a photo of a person {ving} to {obj} as destination',
+    'constraint': 'a photo of a person {ving} with {obj} as constraint',
+}
+
+
+def with_article(noun):
+    noun = noun.replace('_', ' ')
+    return ('an ' if noun[0] in 'aeiou' else 'a ') + noun
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--root', type=Path, default=ROOT)
+    ap.add_argument('--corre', type=Path, default=None, help='triplet inventory; default = train co-occurrence')
+    ap.add_argument('--out', type=Path, default=OUT)
+    a = ap.parse_args()
+    root, out = a.root, a.out
+    classes = json.loads((root / 'classes.json').read_text())
+    objects, inter_vr = classes['objects'], classes['interaction_verb_role']
+    assert len(objects) == 437 and len(inter_vr) == 225 and classes['person_id'] == 0
+    train = json.loads((root / 'train_heir.json').read_text())
+    seen = set()
+    for img in train:
+        for h in img['hoi_annotation']:
+            seen.add((h['category_id'], img['annotations'][h['object_id']]['category_id']))
+    if a.corre is None:
+        corre = np.load(root / 'corre_heir.npy')
+        assert seen == {(int(i), int(o)) for o, i in zip(*np.nonzero(corre))}, 'train triplets != corre_heir.npy'
+        triplets = sorted(seen)
+    else:
+        corre = np.load(a.corre)
+        assert corre.shape == (437, 225)
+        triplets = sorted((int(i), int(o)) for o, i in zip(*np.nonzero(corre)))
+        assert seen <= set(triplets), 'train triplets outside the inventory: %s' % sorted(seen - set(triplets))[:10]
+        print('inventory triplets', len(triplets), '; with train positives', len(seen))
+    labels = OrderedDict()
+    for inter_id, obj_id in triplets:
+        verb, role = inter_vr[inter_id]
+        ving = GERUND[verb]
+        if role == 'target' and TARGET_PREP.get(verb):
+            ving = ving + ' ' + TARGET_PREP[verb]
+        labels[(inter_id, obj_id)] = ROLE_TEMPLATE[role].format(ving=ving, obj=with_article(objects[obj_id]))
+    obj_labels = [(i, 'a photo of ' + with_article(o)) for i, o in enumerate(objects)]
+    obj_labels.append((len(objects), 'a photo of nothing'))
+    with out.open('w') as f:
+        f.write('# Generated by tools/build_heir_text_labels.py -- do not edit.\n')
+        f.write('# source: %s ; key = (HEIR interaction id 0..224, HEIR object id 0..436); %d triplets.\n' % (a.corre or 'train co-occurrence', len(labels)))
+        f.write('heir_text_label = {\n')
+        for k, v in labels.items():
+            f.write('    %r: %r,\n' % (k, v))
+        f.write('}\n\nheir_obj_text_label = [\n')
+        for k, v in obj_labels:
+            f.write('    (%d, %r),\n' % (k, v))
+        f.write(']\n')
+    print('wrote', out, len(labels), 'triplets;', len(obj_labels), 'object prompts')
+    for k in list(labels)[:5] + list(labels)[-5:]:
+        print(k, labels[k])
+
+
+if __name__ == '__main__':
+    main()
