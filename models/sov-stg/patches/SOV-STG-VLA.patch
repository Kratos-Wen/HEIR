diff --git a/export_heir.py b/export_heir.py
new file mode 100644
index 0000000..e9eca16
--- /dev/null
+++ b/export_heir.py
@@ -0,0 +1,165 @@
+"""Export SOV-STG-VLA predictions on HEIR val/test as JSONL for the shared HEIR scorer.
+
+Post-processing = SOV-STG-VLA's HICO-DET protocol (engine.evaluate_hoi -> PostProcessHOI ->
+datasets_hoi/hico_eval_triplet.HICOEvaluator), unchanged:
+  * PostProcessHOI: hoi_scores = sigmoid of the triplet logits [Q, T] (T = 9,764 inventory triplets);
+    boxes cxcywh -> xyxy scaled to the original image size; obj label = argmax softmax (kept for the NMS key).
+  * HICOEvaluator: score = hoi_scores only (the obj-score product and the correct_mat mask are commented
+    out upstream); every (query, triplet) is a candidate; top-100 per image (util.topk.top_k = sorted
+    descending), then triplet pairwise NMS (use_nms True, nms_thresh 0.7, nms_alpha 1.0, nms_beta 0.5),
+    grouped by (subject argmax label, object argmax label, triplet id) as upstream.
+  * The triplet id defines the interaction (category_id) and the object noun of the prediction.
+Output line: {"image_id", "boxes" (original pixels, xyxy), "labels", "box_scores",
+"hois": [{"subject_id","object_id","category_id","score"}]}; one line per split image in split order;
+images beyond --limit get empty predictions. box_scores: softmax prob of the triplet's noun for object boxes;
+subject boxes get 1.0 (no subject classifier).
+"""
+import argparse
+import json
+import os
+import sys
+import time
+from pathlib import Path
+
+import numpy as np
+import torch
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+
+import util.misc as utils  # noqa: E402
+from datasets_hoi import build_dataset  # noqa: E402
+from datasets_hoi.heir_text_label_sem10072 import heir_text_label  # noqa: E402
+from models import build_model  # noqa: E402
+
+MAX_HOIS = 100
+
+
+def pairwise_nms(subs, objs, scores, thres, alpha, beta):
+    # verbatim logic of HICOEvaluator.pairwise_nms (hico_eval_triplet.py)
+    sx1, sy1, sx2, sy2 = subs[:, 0], subs[:, 1], subs[:, 2], subs[:, 3]
+    ox1, oy1, ox2, oy2 = objs[:, 0], objs[:, 1], objs[:, 2], objs[:, 3]
+    sub_areas = (sx2 - sx1 + 1) * (sy2 - sy1 + 1)
+    obj_areas = (ox2 - ox1 + 1) * (oy2 - oy1 + 1)
+    order = scores.argsort()[::-1]
+    keep = []
+    while order.size > 0:
+        i = order[0]
+        keep.append(i)
+        sw = np.maximum(0.0, np.minimum(sx2[i], sx2[order[1:]]) - np.maximum(sx1[i], sx1[order[1:]]) + 1)
+        sh = np.maximum(0.0, np.minimum(sy2[i], sy2[order[1:]]) - np.maximum(sy1[i], sy1[order[1:]]) + 1)
+        sub_inter = sw * sh
+        sub_union = sub_areas[i] + sub_areas[order[1:]] - sub_inter
+        ow = np.maximum(0.0, np.minimum(ox2[i], ox2[order[1:]]) - np.maximum(ox1[i], ox1[order[1:]]) + 1)
+        oh = np.maximum(0.0, np.minimum(oy2[i], oy2[order[1:]]) - np.maximum(oy1[i], oy1[order[1:]]) + 1)
+        obj_inter = ow * oh
+        obj_union = obj_areas[i] + obj_areas[order[1:]] - obj_inter
+        ovr = np.power(sub_inter / sub_union, alpha) * np.power(obj_inter / obj_union, beta)
+        order = order[np.where(ovr <= thres)[0] + 1]
+    return keep
+
+
+def image_record(image_id, res, trip_inter, trip_obj, args):
+    hoi = res['hoi_scores'].numpy().astype(np.float64)   # [Q, T]
+    obj = res['obj_scores'].numpy()                       # [Q, C] softmax
+    boxes = res['boxes'].numpy()                          # [2Q, 4]: subjects then objects
+    labels = res['labels'].numpy()                        # [2Q] argmax labels (subject = 0)
+    nq = hoi.shape[0]
+    flat = hoi.ravel()
+    top = np.argsort(-flat, kind='stable')[:MAX_HOIS]     # == top_k (descending), first index on ties
+    q_idx, t_idx = top // hoi.shape[1], top % hoi.shape[1]
+    s_top = flat[top]
+    keep_all = list(range(len(top)))
+    if args.use_nms and len(top):
+        keep_all, groups = [], {}
+        for k in range(len(top)):
+            groups.setdefault((int(labels[q_idx[k]]), int(labels[nq + q_idx[k]]), int(t_idx[k])), []).append(k)
+        for idx in groups.values():
+            idx = np.array(idx)
+            kk = pairwise_nms(boxes[q_idx[idx]], boxes[nq + q_idx[idx]], s_top[idx], args.nms_thresh, args.nms_alpha, args.nms_beta)
+            keep_all.extend(idx[kk].tolist())
+        keep_all = sorted(keep_all)
+    out_boxes, out_labels, box_scores, node, hois = [], [], [], {}, []
+
+    def get_node(key, box, label, bscore):
+        if key not in node:
+            node[key] = len(out_boxes)
+            out_boxes.append([round(float(v), 2) for v in box])
+            out_labels.append(int(label))
+            box_scores.append(float(min(1.0, max(0.0, bscore))))
+        return node[key]
+
+    for i in keep_all:
+        q, t = int(q_idx[i]), int(t_idx[i])
+        c = int(trip_obj[t])
+        sid = get_node(('s', q), boxes[q], 0, 1.0)
+        oid = get_node(('o', q, c), boxes[nq + q], c, obj[q, c])
+        hois.append({'subject_id': sid, 'object_id': oid, 'category_id': int(trip_inter[t]), 'score': float(s_top[i])})
+    return {'image_id': image_id, 'boxes': out_boxes, 'labels': out_labels, 'box_scores': box_scores, 'hois': hois}
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--checkpoint', required=True)
+    ap.add_argument('--split', choices=('val', 'test'), required=True)
+    ap.add_argument('--output', required=True)
+    ap.add_argument('--hoi_path', required=True)
+    ap.add_argument('--batch_size', type=int, default=4)
+    ap.add_argument('--num_workers', type=int, default=4)
+    ap.add_argument('--limit', type=int, default=0, help='only run the first N images (others empty)')
+    a = ap.parse_args()
+
+    ckpt = torch.load(a.checkpoint, map_location='cpu', weights_only=False)
+    args = ckpt['args']
+    args.hoi_path = a.hoi_path
+    args.distributed = False
+    args.device = 'cuda'
+    args.eval = True
+    device = torch.device('cuda')
+    torch.manual_seed(args.seed)
+
+    model, _, postprocessors = build_model(args)
+    info = model.load_state_dict(ckpt['model'], strict=False)
+    assert not info.unexpected_keys, info.unexpected_keys
+    # only the frozen BLIP-2 advisor (not saved in the checkpoint) may be missing
+    assert all(k.startswith('blip2_model.') for k in info.missing_keys), [k for k in info.missing_keys if not k.startswith('blip2_model.')]
+    print('load: epoch', ckpt.get('epoch'), 'missing (blip2 only):', len(info.missing_keys), flush=True)
+    model.to(device).eval()
+
+    keys = list(heir_text_label.keys())
+    trip_inter = np.array([k[0] for k in keys])
+    trip_obj = np.array([k[1] for k in keys])
+
+    ds = build_dataset(image_set=a.split, args=args)
+    n = len(ds) if not a.limit else min(a.limit, len(ds))
+    sub = torch.utils.data.Subset(ds, list(range(n)))
+    loader = torch.utils.data.DataLoader(sub, batch_size=a.batch_size, shuffle=False, drop_last=False,
+                                         collate_fn=utils.collate_fn, num_workers=a.num_workers)
+    records = []
+    t0 = time.time()
+    with torch.no_grad():
+        for bi, (samples, targets) in enumerate(loader):
+            samples = samples.to(device)
+            targets_t = [{k: v.to(device) for k, v in t.items() if k not in ('file_name', 'id', 'img_id', 'image_id')} for t in targets]
+            outputs, _ = model(samples, dn_args=(targets_t, 0,))  # as engine.evaluate_hoi
+            orig_sizes = torch.stack([t['orig_size'] for t in targets]).to(device)
+            results = postprocessors['hoi'](outputs, orig_sizes)
+            for t, res in zip(targets, results):
+                records.append(image_record(t['image_id'], res, trip_inter, trip_obj, args))
+            if bi % 100 == 0:
+                print(f'[{a.split}] {bi * a.batch_size}/{n} images, {time.time() - t0:.1f}s', flush=True)
+
+    all_ids = [str(x['image_id']) for x in ds.annotations]
+    assert [r['image_id'] for r in records] == all_ids[:n]
+    out = Path(a.output)
+    out.parent.mkdir(parents=True, exist_ok=True)
+    with open(out, 'w') as f:
+        for r in records:
+            f.write(json.dumps(r) + '\n')
+        for iid in all_ids[n:]:
+            f.write(json.dumps({'image_id': iid, 'boxes': [], 'labels': [], 'box_scores': [], 'hois': []}) + '\n')
+    print('wrote', out, len(all_ids), 'lines;', n, 'with predictions;', sum(len(r['hois']) for r in records), 'hois')
+    print(f'export done in {time.time() - t0:.1f}s ({n / max(1e-6, time.time() - t0):.2f} img/s)')
+
+
+if __name__ == '__main__':
+    main()
