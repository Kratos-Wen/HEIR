+++ b/convert_parameters_heir.py
@@ -0,0 +1,128 @@
+"""Build the SOV-STG HEIR init checkpoint from the official DN-Deformable-DETR R50 (50 ep, 49.5 AP).
+
+The official DN-DETR Google-Drive folder referenced by the SOV-STG README
+(drive/folders/1pIllR0VfSIqX8TmQy0PFNiPdp87j-78j, checkpoint0049.pth) is gone (HTTP 404, checked 2026-09-23).
+The same weights are published by IDEA-Research (DN-DETR authors) in detrex as
+`converted_dn_deformable_detr_r50_50ep.pth` (detrex-storage release v0.1.0), produced by
+detrex/projects/dn_deformable_detr/converter.py, which is a pure key rename except:
+  * class_embed.*   : 91 -> 80 rows (COCO ids)          -- not used here (object head re-initialised)
+  * label_enc       : 92 -> 81 rows, renamed label_encoder -- not used here (re-initialised)
+
+Step 1 inverts the detrex rename exactly -> DN-DETR (DAB-Deformable-DETR) key names.
+Step 2 applies upstream SOV-STG convert_parameters.py (DN-DETR -> SOV-STG) unchanged, except that
+the object classifier (class_embed.*) and the DN label embedding (label_enc) are dropped so that they are
+freshly initialised for 437 HEIR objects (upstream subsets them to the 80 HICO/COCO classes).
+"""
+import argparse
+import re
+
+import torch
+
+
+def detrex_to_dndetr(sd):
+    out = {}
+    for k, v in sd.items():
+        nk = k
+        if k.startswith('backbone.'):
+            nk = k[len('backbone.'):]
+            if nk.startswith('stem.'):
+                nk = nk[len('stem.'):]
+            for t in [1, 2, 3, 4]:
+                nk = nk.replace(f'res{t + 1}.', f'layer{t}.')
+            nk = nk.replace('shortcut.norm.', 'downsample.1.')
+            nk = nk.replace('shortcut.', 'downsample.0.')
+            for t in [1, 2, 3]:
+                nk = nk.replace(f'conv{t}.norm.', f'bn{t}.')
+            nk = 'backbone.0.body.' + nk
+        elif k.startswith('neck.'):
+            m = re.match(r'neck\.convs\.(\d)\.(conv|norm)\.(.*)', k)
+            if m:
+                nk = f'input_proj.{m.group(1)}.{0 if m.group(2) == "conv" else 1}.{m.group(3)}'
+            else:
+                m = re.match(r'neck\.extra_convs\.0\.(conv|norm)\.(.*)', k)
+                assert m, k
+                nk = f'input_proj.3.{0 if m.group(1) == "conv" else 1}.{m.group(2)}'
+        elif 'encoder.layers' in k:
+            nk = (k.replace('attentions.0.', 'self_attn.').replace('ffns.0.layers.0.0.', 'linear1.')
+                   .replace('ffns.0.layers.1.', 'linear2.').replace('norms.0.', 'norm1.').replace('norms.1.', 'norm2.'))
+        elif 'decoder.layers' in k:
+            nk = (k.replace('attentions.0.attn.', 'self_attn.').replace('attentions.1.', 'cross_attn.')
+                   .replace('ffns.0.layers.0.0.', 'linear1.').replace('ffns.0.layers.1.', 'linear2.')
+                   .replace('norms.0.', 'norm2.').replace('norms.1.', 'norm1.').replace('norms.2.', 'norm3.'))
+        elif k == 'transformer.level_embeds':
+            nk = 'transformer.level_embed'
+        elif k == 'label_encoder.weight':
+            nk = 'label_enc.weight'
+        assert nk not in out, nk
+        out[nk] = v
+    return out
+
+
+def dndetr_to_sovstg(model, num_queries=64, dec_n_points=8, enc_n_points=4):
+    """upstream convert_parameters.py main(), with the object head dropped (see module doc)."""
+    ps = {'model': dict(model)}
+    for k in list(ps['model'].keys()):
+        if 'decoder' in k:
+            ps['model'][k.replace('decoder', 'sub_decoder')] = ps['model'][k].clone()
+    for i in range(6):
+        # HEIR: drop COCO classifier instead of subsetting to 80 classes
+        ps['model'].pop(f'class_embed.{i}.weight')
+        ps['model'].pop(f'class_embed.{i}.bias')
+
+        dec_offsets_w = ps['model'][f'transformer.decoder.layers.{i}.cross_attn.sampling_offsets.weight'].clone()
+        dec_offsets_b = ps['model'][f'transformer.decoder.layers.{i}.cross_attn.sampling_offsets.bias'].clone()
+        dec_attention_weights_w = ps['model'][f'transformer.decoder.layers.{i}.cross_attn.attention_weights.weight'].clone()
+        dec_attention_weights_b = ps['model'][f'transformer.decoder.layers.{i}.cross_attn.attention_weights.bias'].clone()
+        enc_offsets_w = ps['model'][f'transformer.encoder.layers.{i}.self_attn.sampling_offsets.weight'].clone()
+        enc_offsets_b = ps['model'][f'transformer.encoder.layers.{i}.self_attn.sampling_offsets.bias'].clone()
+        enc_attention_weights_w = ps['model'][f'transformer.encoder.layers.{i}.self_attn.attention_weights.weight'].clone()
+        enc_attention_weights_b = ps['model'][f'transformer.encoder.layers.{i}.self_attn.attention_weights.bias'].clone()
+        dec_pattern = dec_n_points // 4
+        enc_pattern = enc_n_points // 4
+        for dname in ('decoder', 'sub_decoder'):
+            ps['model'][f'transformer.{dname}.layers.{i}.cross_attn.sampling_offsets.weight'] = torch.cat([dec_offsets_w] * dec_pattern)
+            ps['model'][f'transformer.{dname}.layers.{i}.cross_attn.sampling_offsets.bias'] = torch.cat([dec_offsets_b] * dec_pattern)
+            ps['model'][f'transformer.{dname}.layers.{i}.cross_attn.attention_weights.weight'] = torch.cat([dec_attention_weights_w] * dec_pattern)
+            ps['model'][f'transformer.{dname}.layers.{i}.cross_attn.attention_weights.bias'] = torch.cat([dec_attention_weights_b] * dec_pattern)
+        ps['model'][f'transformer.encoder.layers.{i}.self_attn.sampling_offsets.weight'] = torch.cat([enc_offsets_w] * enc_pattern)
+        ps['model'][f'transformer.encoder.layers.{i}.self_attn.sampling_offsets.bias'] = torch.cat([enc_offsets_b] * enc_pattern)
+        ps['model'][f'transformer.encoder.layers.{i}.self_attn.attention_weights.weight'] = torch.cat([enc_attention_weights_w] * enc_pattern)
+        ps['model'][f'transformer.encoder.layers.{i}.self_attn.attention_weights.bias'] = torch.cat([enc_attention_weights_b] * enc_pattern)
+        for j in range(3):
+            ps['model'][f'sub_bbox_embed.{i}.layers.{j}.weight'] = ps['model'][f'bbox_embed.{i}.layers.{j}.weight'].clone()
+            ps['model'][f'sub_bbox_embed.{i}.layers.{j}.bias'] = ps['model'][f'bbox_embed.{i}.layers.{j}.bias'].clone()
+
+    ps['model']['refpoint_obj_embed.weight'] = ps['model']['refpoint_embed.weight'].clone()[:num_queries]
+    ps['model']['refpoint_sub_embed.weight'] = ps['model']['refpoint_embed.weight'].clone()[:num_queries]
+    ps['model']['tgt_embed.weight'] = ps['model']['tgt_embed.weight'].clone()[:num_queries]
+    # HEIR: drop COCO DN label embedding (upstream: label_enc[obj_ids]); re-initialised for 437 classes
+    ps['model'].pop('label_enc.weight')
+    w = ps['model']['transformer.decoder.ref_point_head.layers.0.weight'].clone()
+    b = ps['model']['transformer.decoder.ref_point_head.layers.0.bias'].clone()
+    ps['model']['transformer.sub_decoder.ref_point_head.layers.0.weight'] = w
+    ps['model']['transformer.sub_decoder.ref_point_head.layers.0.bias'] = b
+    return ps
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--load_path', required=True, help='detrex converted_dn_deformable_detr_r50_50ep.pth')
+    ap.add_argument('--from_dndetr', action='store_true',
+                    help='load_path is already in DN-DETR key format (e.g. SOV-STG dn_dab_deformable_detr_swin_large.pth): skip step 1')
+    ap.add_argument('--dndetr_path', default='', help='optional: save reconstructed DN-DETR-format checkpoint')
+    ap.add_argument('--save_path', required=True)
+    ap.add_argument('--num_queries', type=int, default=64)
+    ap.add_argument('--dec_n_points', type=int, default=8)
+    ap.add_argument('--enc_n_points', type=int, default=4)
+    a = ap.parse_args()
+    sd = torch.load(a.load_path, map_location='cpu', weights_only=False)['model']
+    dn = sd if a.from_dndetr else detrex_to_dndetr(sd)
+    if a.dndetr_path:
+        torch.save({'model': dn}, a.dndetr_path)
+    ps = dndetr_to_sovstg(dn, a.num_queries, a.dec_n_points, a.enc_n_points)
+    torch.save(ps, a.save_path)
+    print('saved', a.save_path, len(ps['model']), 'tensors')
+
+
+if __name__ == '__main__':
+    main()
