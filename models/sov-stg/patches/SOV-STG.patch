diff --git a/datasets/heir.py b/datasets/heir.py
new file mode 100644
index 0000000..4392e89
--- /dev/null
+++ b/datasets/heir.py
@@ -0,0 +1,151 @@
+# ------------------------------------------------------------------------
+# HEIR v1.0 dataset for SOV-STG (HICO-DET-style loader).
+# Mirrors datasets/hico.py (HICODetection) line by line:
+#   * same augmentations (make_hico_transforms: flip, ColorJitter(.4,.4,.4),
+#     multi-scale 480-800 / max 1333 with RandomSizeCrop branch; val: 800/1333),
+#   * same train sanity filter and same truncation of box lists to num_queries,
+#   * same multi-label pair targets (annotations of one (subject, object) pair are
+#     merged into one multi-hot interaction vector), same target keys, which are
+#     also the inputs of the STG denoising queries (obj_labels, verb_labels,
+#     sub_boxes, obj_boxes).
+# Differences to hico.py:
+#   * ids are already contiguous: objects 0..436 (person = 0), interactions
+#     0..224 (one per (verb, role) pair) -> no _valid_obj_ids/_valid_verb_ids remap;
+#   * no HICO_rare2015 hard-coded path;
+#   * val/test targets carry the HEIR image_id (str) for the JSONL export;
+#   * correct_mat = corre_heir.npy ([437 objects, 225 interactions]) transposed to
+#     HICO's [interaction, object] layout (HICOEvaluator indexes correct_mat[verb, obj]).
+# ------------------------------------------------------------------------
+import json
+from pathlib import Path
+
+import numpy as np
+import torch
+import torch.utils.data
+from PIL import Image
+
+from datasets.hico import make_hico_transforms
+
+NUM_OBJ = 437
+NUM_INTER = 225
+
+
+class HEIRDetection(torch.utils.data.Dataset):
+
+    def __init__(self, img_set, img_folder, anno_file, transforms, num_queries):
+        self.img_set = img_set
+        self.img_folder = Path(img_folder)
+        with open(anno_file, 'r') as f:
+            self.annotations = json.load(f)
+        self._transforms = transforms
+        self.num_queries = num_queries
+        self.num_verbs = NUM_INTER
+
+        if img_set == 'train':
+            self.ids = []
+            for idx, img_anno in enumerate(self.annotations):
+                for hoi in img_anno['hoi_annotation']:
+                    if hoi['subject_id'] >= len(img_anno['annotations']) or hoi['object_id'] >= len(img_anno['annotations']):
+                        break
+                else:
+                    self.ids.append(idx)
+        else:
+            self.ids = list(range(len(self.annotations)))
+
+    def __len__(self):
+        return len(self.ids)
+
+    def __getitem__(self, idx):
+        img_anno = self.annotations[self.ids[idx]]
+        img = Image.open(self.img_folder / img_anno['file_name']).convert('RGB')
+        w, h = img.size
+
+        annos = img_anno['annotations']
+        if self.img_set == 'train' and len(annos) > self.num_queries:
+            annos = annos[:self.num_queries]  # as hico.py
+
+        boxes = torch.as_tensor([obj['bbox'] for obj in annos], dtype=torch.float32).reshape(-1, 4)
+
+        target = {}
+        target['orig_size'] = torch.as_tensor([int(h), int(w)])
+        target['size'] = torch.as_tensor([int(h), int(w)])
+        if self.img_set == 'train':
+            classes = torch.tensor([(i, obj['category_id']) for i, obj in enumerate(annos)],
+                                   dtype=torch.int64).reshape(-1, 2)
+            boxes[:, 0::2].clamp_(min=0, max=w)
+            boxes[:, 1::2].clamp_(min=0, max=h)
+            keep = (boxes[:, 3] > boxes[:, 1]) & (boxes[:, 2] > boxes[:, 0])
+            boxes = boxes[keep]
+            classes = classes[keep]
+
+            target['boxes'] = boxes
+            target['labels'] = classes
+            target['iscrowd'] = torch.zeros((boxes.shape[0],), dtype=torch.int64)
+            target['area'] = (boxes[:, 2] - boxes[:, 0]) * (boxes[:, 3] - boxes[:, 1])
+
+            if self._transforms is not None:
+                img_0, target_0 = self._transforms[0](img, target)
+                img, target = self._transforms[1](img_0, target_0)
+
+            kept_box_indices = [int(label[0]) for label in target['labels']]
+            target['labels'] = target['labels'][:, 1]
+
+            obj_labels, verb_labels, sub_boxes, obj_boxes = [], [], [], []
+            sub_obj_pairs = []
+            for hoi in img_anno['hoi_annotation']:
+                if hoi['subject_id'] not in kept_box_indices or hoi['object_id'] not in kept_box_indices:
+                    continue
+                pair = (hoi['subject_id'], hoi['object_id'])
+                if pair in sub_obj_pairs:
+                    verb_labels[sub_obj_pairs.index(pair)][hoi['category_id']] = 1
+                else:
+                    sub_obj_pairs.append(pair)
+                    obj_labels.append(target['labels'][kept_box_indices.index(hoi['object_id'])])
+                    verb_label = [0] * self.num_verbs
+                    verb_label[hoi['category_id']] = 1
+                    verb_labels.append(verb_label)
+                    sub_boxes.append(target['boxes'][kept_box_indices.index(hoi['subject_id'])])
+                    obj_boxes.append(target['boxes'][kept_box_indices.index(hoi['object_id'])])
+            if len(sub_obj_pairs) == 0:
+                target['obj_labels'] = torch.zeros((0,), dtype=torch.int64)
+                target['verb_labels'] = torch.zeros((0, self.num_verbs), dtype=torch.float32)
+                target['sub_boxes'] = torch.zeros((0, 4), dtype=torch.float32)
+                target['obj_boxes'] = torch.zeros((0, 4), dtype=torch.float32)
+            else:
+                target['obj_labels'] = torch.stack(obj_labels)
+                target['verb_labels'] = torch.as_tensor(verb_labels, dtype=torch.float32)
+                target['sub_boxes'] = torch.stack(sub_boxes)
+                target['obj_boxes'] = torch.stack(obj_boxes)
+        else:
+            target['boxes'] = boxes
+            target['labels'] = torch.tensor([obj['category_id'] for obj in annos], dtype=torch.int64)
+            target['id'] = idx
+            target['file_name'] = img_anno['file_name']
+            target['image_id'] = str(img_anno['image_id'])
+
+            if self._transforms is not None:
+                img, _ = self._transforms(img, None)
+
+            hois = [(hoi['subject_id'], hoi['object_id'], hoi['category_id']) for hoi in img_anno['hoi_annotation']]
+            target['hois'] = torch.as_tensor(hois, dtype=torch.int64).reshape(-1, 3)
+
+        return img, target
+
+    def load_correct_mat(self, path):
+        m = np.load(path)
+        assert m.shape == (NUM_OBJ, NUM_INTER), m.shape
+        self.correct_mat = m.T.astype(np.float64)  # [interaction, object] like corre_hico.npy
+
+
+def build(image_set, args):
+    root = Path(args.hoi_path)
+    assert root.exists(), f'provided HOI path {root} does not exist'
+    assert args.num_obj_classes == NUM_OBJ and args.num_verb_classes == NUM_INTER
+    split = {'train': 'train', 'val': 'val', 'test': 'test'}[image_set]
+    anno_file = root / 'annotations' / f'{split}_heir.json'
+    dataset = HEIRDetection(image_set if image_set == 'train' else 'val', root / 'images', anno_file,
+                            transforms=make_hico_transforms('train' if image_set == 'train' else 'val'),
+                            num_queries=args.num_queries)
+    if image_set != 'train':
+        dataset.load_correct_mat(root / 'annotations' / 'corre_heir.npy')
+    return dataset
