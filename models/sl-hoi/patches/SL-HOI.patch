index 0000000..5602f57
--- /dev/null
+++ b/test_vcoco_adapter.py
@@ -0,0 +1,60 @@
+import unittest
+
+import numpy as np
+import torch
+
+from datasets.vcoco_text_label import vcoco_hoi_text_label, vcoco_obj_text_label
+from vcoco_protocol import VCOCOExport, VERBS
+
+
+class VCOCOAdapterTests(unittest.TestCase):
+    def prediction(self, missing=False):
+        return {"hoi_scores": torch.zeros(1, 263), "obj_scores": torch.zeros(1, 82),
+                "labels": torch.tensor([0, 80 if missing else 43]),
+                "boxes": torch.tensor([[10., 20., 80., 100.], [20., 25., 50., 60.]]),
+                "sub_ids": torch.tensor([0]), "obj_ids": torch.tensor([1])}
+
+    def test_label_contract(self):
+        self.assertEqual(len(vcoco_hoi_text_label), 263)
+        self.assertEqual([i for i, _ in vcoco_obj_text_label], list(range(82)))
+        self.assertEqual({v for v, _ in vcoco_hoi_text_label}, set(range(29)))
+        self.assertIn((16, 80), vcoco_hoi_text_label)
+        self.assertIn((17, 80), vcoco_hoi_text_label)
+
+    def test_role_scores_are_distinct(self):
+        prediction = self.prediction()
+        keys = list(vcoco_hoi_text_label)
+        prediction["hoi_scores"][0, keys.index((16, 43))] = .9
+        prediction["hoi_scores"][0, keys.index((17, 53))] = .2
+        record = VCOCOExport()(prediction, 123)[0]
+        self.assertAlmostEqual(record["cut_instr"][-1], .9, places=6)
+        self.assertAlmostEqual(record["cut_obj"][-1], .2, places=6)
+        self.assertAlmostEqual(record["cut_agent"], .9, places=6)
+
+    def test_missing_entity_is_not_background(self):
+        record = VCOCOExport()(self.prediction(missing=True), 123)[0]
+        self.assertTrue(np.isnan(record["cut_obj"][:4]).all())
+        self.assertFalse(np.isnan(record["person_box"]).any())
+        self.assertEqual(len([v for v in VERBS if v.endswith(("_obj", "_instr"))]), 25)
+        self.assertEqual(len([key for key in record if key.endswith("_agent")]), 26)
+
+    def test_native_score_addition(self):
+        prediction = self.prediction()
+        prediction["obj_scores"][0, 43] = .5
+        prediction["hoi_scores"][0, list(vcoco_hoi_text_label).index((16, 43))] = .3
+        self.assertAlmostEqual(VCOCOExport()(prediction, 1)[0]["cut_instr"][-1], .55, places=6)
+
+    def test_null_nms_does_not_use_unsupervised_entity_geometry(self):
+        prediction = self.prediction(missing=True)
+        prediction["hoi_scores"] = prediction["hoi_scores"].repeat(2, 1)
+        prediction["obj_scores"] = prediction["obj_scores"].repeat(2, 1)
+        prediction["labels"] = torch.tensor([0, 0, 80, 80])
+        prediction["boxes"] = torch.tensor([[10., 20., 80., 100.], [10., 20., 80., 100.],
+                                             [1., 1., 2., 2.], [1000., 1000., 1200., 1200.]])
+        prediction["sub_ids"] = torch.tensor([0, 1])
+        prediction["obj_ids"] = torch.tensor([2, 3])
+        self.assertEqual(len(VCOCOExport()(prediction, 1)), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
