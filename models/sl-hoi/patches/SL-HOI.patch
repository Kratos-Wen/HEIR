@@ -0,0 +1,346 @@
+"""Isolated V-COCO adaptation of upstream SL-HOI, without CoRISP changes."""
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import pickle
+import shutil
+import subprocess
+import time
+
+import torch
+from torch.utils.data import DataLoader, Dataset, Subset
+from accelerate import Accelerator
+from accelerate.utils import DistributedDataParallelKwargs, set_seed
+from omegaconf import OmegaConf
+from PIL import Image
+
+from datasets.hico import make_hico_transforms
+from datasets.vcoco import VCOCO
+from datasets.vcoco_text_label import vcoco_hoi_text_label, vcoco_obj_text_label
+from models.detection.hico.slhoi import build_detector
+from models.dinov3.hub.dinotxt import dinov3_vitl16_dinotxt_tet1280d20h24l
+from util.misc import collate_fn
+from vcoco_protocol import VCOCOExport, audit_training
+
+REPO = Path(__file__).resolve().parent
+WORKSPACE = REPO.parents[1]
+DATA = WORKSPACE.parent / "data/v-coco"
+WEIGHTS = WORKSPACE / "third_party/SL-HOI/weights/dinov3"
+BACKBONE = WEIGHTS / "dinov3_vitl16_pretrain_lvd1689m-8aa4cbdd.pth"
+TEXT = WEIGHTS / "dinov3_vitl16_dinotxt_vision_head_and_text_encoder-a442d8f5.pth"
+BPE = WEIGHTS / "bpe_simple_vocab_16e6.txt.gz"
+ARCHITECTURE = "slhoi_vcoco_official_architecture_inhouse_adapter_v1"
+
+
+def sha256(path):
+    digest = hashlib.sha256()
+    with Path(path).open("rb") as handle:
+        for block in iter(lambda: handle.read(8 * 1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def atomic_json(path, value):
+    path = Path(path)
+    temporary = path.with_suffix(path.suffix + ".partial")
+    temporary.write_text(json.dumps(value, indent=2, allow_nan=False) + "\n")
+    temporary.replace(path)
+
+
+def source_hashes():
+    return {str(p.relative_to(REPO)): sha256(p) for p in sorted(REPO.rglob("*.py"))}
+
+
+def configure(output):
+    cfg = OmegaConf.merge(OmegaConf.load(REPO / "configs/base.yaml"),
+                          OmegaConf.load(REPO / "configs/hico.yaml"))
+    cfg.INPUT.DATASET_FILE = "vcoco"
+    cfg.INPUT.NUM_OBJ_CLASSES = 81
+    cfg.INPUT.PATH = str(DATA)
+    cfg.MODEL.DINO.DINOTXT_WEIGHTS = str(TEXT)
+    cfg.MODEL.DINO.BACKBONE_WEIGHTS = str(BACKBONE)
+    cfg.MODEL.DINO.BPE_PATH_OR_URL = str(BPE)
+    cfg.ZERO_SHOT.CLASSIFIER.TRAIN = str(output / "classifier_train.pt")
+    cfg.ZERO_SHOT.CLASSIFIER.EVAL = str(output / "classifier_eval.pt")
+    cfg.RUNTIME.DEVICE = "cpu"
+    cfg.SOLVER.BATCH_SIZE = 1
+    cfg.SOLVER.GRADIENT_ACCUMULATION_STEPS = 4
+    return cfg
+
+
+def training_data():
+    return VCOCO("train", DATA / "images/train2014",
+                 DATA / "annotations/trainval_vcoco.json", make_hico_transforms("train"), 64, None)
+
+
+class TestImages(Dataset):
+    """Inference reads image IDs and RGB files, not action annotations."""
+
+    def __init__(self):
+        self.ids = [int(x) for x in (DATA / "data/splits/vcoco_test.ids").read_text().split()]
+        assert len(set(self.ids)) == len(self.ids) == 4946
+        self.transform = make_hico_transforms("val")
+
+    def __len__(self):
+        return len(self.ids)
+
+    def __getitem__(self, index):
+        image_id = self.ids[index]
+        path = DATA / "images/val2014" / f"COCO_val2014_{image_id:012d}.jpg"
+        image = Image.open(path).convert("RGB")
+        width, height = image.size
+        image, _ = self.transform(image, None)
+        return image, {"img_id": image_id, "orig_size": torch.tensor([height, width])}
+
+
+def prepare(output, accelerator):
+    if not accelerator.is_main_process:
+        raise ValueError("Prepare classifier assets on one process only")
+    audit = audit_training(training_data(), DATA / "data/splits/vcoco_trainval.ids")
+    model, tokenizer = dinov3_vitl16_dinotxt_tet1280d20h24l(
+        dinotxt_weights=str(TEXT), backbone_weights=str(BACKBONE), bpe_path_or_url=str(BPE))
+    model.to(accelerator.device).eval()
+
+    def encode(strings):
+        chunks = []
+        with torch.no_grad():
+            for start in range(0, len(strings), 16):
+                inputs = torch.cat([tokenizer.tokenize(s) for s in strings[start:start + 16]])
+                chunks.append(torch.nn.functional.normalize(
+                    model.encode_text(inputs.to(accelerator.device)).float(), dim=-1).cpu())
+        return torch.cat(chunks)
+
+    hoi = encode(list(vcoco_hoi_text_label.values()))
+    objects = encode([text for _, text in vcoco_obj_text_label])
+    assert hoi.shape == (263, 2048) and objects.shape == (82, 2048)
+    torch.save({"hoi_embedding_train": hoi}, output / "classifier_train.pt")
+    torch.save({"hoi_embedding_eval": hoi, "obj_text_embedding_eval": objects}, output / "classifier_eval.pt")
+    atomic_json(output / "class_order.json", {"hoi": list(vcoco_hoi_text_label.items()),
+                                             "objects": vcoco_obj_text_label})
+    inputs = {str(p): sha256(p) for p in [TEXT, BACKBONE, BPE,
+              DATA / "annotations/trainval_vcoco.json", DATA / "data/splits/vcoco_trainval.ids",
+              output / "classifier_train.pt", output / "classifier_eval.pt"]}
+    protocol = {"architecture": ARCHITECTURE, "seed": 42, "epochs": 60,
+                "lr": 1e-4, "weight_decay": 1e-4, "lr_drop_epoch": 40,
+                "world_size": 8, "micro_batch": 1, "accumulation": 4, "global_batch": 32,
+                "initialization": "generic DINOv3/DINO.txt only; no HICO task checkpoint",
+                "checkpoint_rule": "fixed final epoch 60; no test during training",
+                "evidence_type": "INHOUSE_DATASET_ADAPTATION",
+                "upstream_revision": subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=REPO, text=True).strip(),
+                "sources": source_hashes(), "inputs": inputs, "data": audit,
+                "runtime_changes": "DDP instead of ZeRO2; batch 1 x accumulation 4 instead of 2 x 2",
+                "export": "native SL-HOI class scores; GEN-VLKT role mapping; missing-entity NMS uses person geometry"}
+    atomic_json(output / "protocol.json", protocol)
+    OmegaConf.save(configure(output), output / "resolved_config.yaml")
+    print(json.dumps(audit), flush=True)
+
+
+def check_contract(output):
+    protocol = json.loads((output / "protocol.json").read_text())
+    if protocol["architecture"] != ARCHITECTURE or protocol["sources"] != source_hashes():
+        raise ValueError("Adapter source changed since protocol preparation")
+    for path, expected in protocol["inputs"].items():
+        if sha256(path) != expected:
+            raise ValueError(f"Input changed: {path}")
+    return protocol
+
+
+def validate(output, accelerator):
+    data = training_data()
+    audit = audit_training(data, DATA / "data/splits/vcoco_trainval.ids")
+    model, criterion, post = build_detector(configure(output), is_fresh_train=True)
+    model.to(accelerator.device).train()
+    criterion.to(accelerator.device)
+    null_index = next(i for i, row in enumerate(data.annotations)
+                      if any(e["object_id"] == -1 for e in row["hoi_annotation"]))
+    image, target = data[null_index]
+    samples, targets = collate_fn([(image, target)])
+    samples = samples.to(accelerator.device)
+    targets = [{k: v.to(accelerator.device) if torch.is_tensor(v) else v for k, v in t.items()} for t in targets]
+    with accelerator.autocast():
+        outputs = model(samples)
+        terms = criterion(outputs, targets)
+        loss = sum(terms[k] * criterion.weight_dict[k] for k in criterion.weight_dict)
+    accelerator.backward(loss)
+    assert torch.isfinite(loss)
+    for name, parameter in model.named_parameters():
+        if not parameter.requires_grad:
+            assert parameter.grad is None, name
+        elif parameter.grad is not None:
+            assert torch.isfinite(parameter.grad).all(), name
+    exported = VCOCOExport()(post["hoi"](outputs, target["orig_size"][None])[0], 1)
+    assert exported and "cut_instr" in exported[0] and "cut_obj" in exported[0]
+    report = {**audit, "finite_loss": float(loss.detach()), "gradient_check_passed": True,
+              "missing_entity_sample": target["filename"], "exported_queries": len(exported),
+              "peak_allocated_mib": torch.cuda.max_memory_allocated() / 2**20}
+    atomic_json(output / "conformance.json", report)
+    print(json.dumps(report), flush=True)
+
+
+def save_epoch(accelerator, output, epoch, fingerprint):
+    folder = output / f"checkpoint-epoch-{epoch:03d}"
+    # All ranks must finish the existence check before any rank starts saving.
+    exists = torch.tensor(int(folder.exists()), device=accelerator.device)
+    exists = accelerator.reduce(exists, reduction="sum")
+    if int(exists):
+        raise FileExistsError(folder)
+    accelerator.wait_for_everyone()
+    accelerator.save_state(str(folder))
+    accelerator.wait_for_everyone()
+    if accelerator.is_main_process:
+        required = [folder / f"random_states_{rank}.pkl" for rank in range(accelerator.num_processes)]
+        required += [folder / name for name in ("model.safetensors", "optimizer.bin", "custom_checkpoint_0.pkl")]
+        if not all(path.is_file() for path in required):
+            raise RuntimeError("Incomplete distributed checkpoint: refuse completion marker")
+        atomic_json(folder / "complete.json", {"completed_epochs": epoch, "protocol_sha256": fingerprint,
+                    "world_size": accelerator.num_processes, "training_complete": epoch == 60})
+        atomic_json(output / "latest.json", {"checkpoint": folder.name})
+        previous = output / f"checkpoint-epoch-{epoch - 1:03d}"
+        if epoch > 1 and (epoch - 1) % 10 and (previous / "complete.json").exists():
+            shutil.rmtree(previous)
+    accelerator.wait_for_everyone()
+
+
+def train(output, accelerator, resume):
+    protocol = check_contract(output)
+    if accelerator.num_processes != 8:
+        raise ValueError("Formal run requires 8 ranks and fixed global batch 32")
+    fingerprint = sha256(output / "protocol.json")
+    model, criterion, _ = build_detector(configure(output), is_fresh_train=True)
+    optimizer = torch.optim.AdamW([p for p in model.parameters() if p.requires_grad], lr=1e-4, weight_decay=1e-4)
+    scheduler = torch.optim.lr_scheduler.MultiStepLR(optimizer, [40], gamma=0.1)
+    loader = DataLoader(training_data(), batch_size=1, shuffle=True, num_workers=2,
+                        collate_fn=collate_fn, pin_memory=True)
+    model, optimizer, loader = accelerator.prepare(model, optimizer, loader)
+    criterion.to(accelerator.device)
+    accelerator.register_for_checkpointing(scheduler)
+    start_epoch = 0
+    if resume:
+        metadata = json.loads((resume / "complete.json").read_text())
+        if metadata["protocol_sha256"] != fingerprint or metadata["world_size"] != 8:
+            raise ValueError("Incompatible checkpoint")
+        accelerator.load_state(str(resume))
+        start_epoch = metadata["completed_epochs"]
+    elif (output / "latest.json").exists():
+        raise ValueError("Existing run: explicitly resume its complete checkpoint")
+    accelerator.print(json.dumps({"phase": "train", "images": len(loader.dataset),
+        "steps_per_rank": len(loader), "world_size": accelerator.num_processes,
+        "global_batch": 32, "epochs": 60, "start_epoch": start_epoch,
+        "total_parameters": sum(p.numel() for p in model.parameters()),
+        "trainable_parameters": sum(p.numel() for p in model.parameters() if p.requires_grad)}))
+    for epoch in range(start_epoch, 60):
+        model.train()
+        if hasattr(loader, "set_epoch"):
+            loader.set_epoch(epoch)
+        started = time.monotonic()
+        losses = []
+        for step, (samples, targets) in enumerate(loader):
+            with accelerator.accumulate(model):
+                samples = samples.to(accelerator.device)
+                targets = [{k: v.to(accelerator.device) if torch.is_tensor(v) else v
+                            for k, v in target.items()} for target in targets]
+                with accelerator.autocast():
+                    terms = criterion(model(samples), targets)
+                    loss = sum(terms[k] * criterion.weight_dict[k] for k in criterion.weight_dict)
+                if not torch.isfinite(loss):
+                    raise FloatingPointError(f"Nonfinite loss at epoch {epoch + 1}, step {step}")
+                accelerator.backward(loss)
+                if accelerator.sync_gradients:
+                    norm = accelerator.clip_grad_norm_(model.parameters(), 0.1)
+                    if not torch.isfinite(norm):
+                        raise FloatingPointError("Nonfinite gradient norm")
+                optimizer.step()
+                optimizer.zero_grad()
+            losses.append(float(loss.detach()))
+            if step % 25 == 0:
+                accelerator.print(f"epoch={epoch + 1}/60 step={step + 1}/{len(loader)} loss={losses[-1]:.5f}", flush=True)
+        scheduler.step()
+        mean_loss = accelerator.reduce(torch.tensor(sum(losses) / len(losses), device=accelerator.device), reduction="mean")
+        record = {"epoch": epoch + 1, "train_loss": float(mean_loss), "seconds": time.monotonic() - started,
+                  "lr": optimizer.param_groups[0]["lr"], "test_evaluated": False,
+                  "peak_allocated_mib": torch.cuda.max_memory_allocated() / 2**20}
+        if accelerator.is_main_process:
+            with (output / "train.jsonl").open("a") as handle:
+                handle.write(json.dumps(record) + "\n")
+            print(json.dumps(record), flush=True)
+        save_epoch(accelerator, output, epoch + 1, fingerprint)
+
+
+def test(output, accelerator, resume):
+    check_contract(output)
+    if resume is None:
+        raise ValueError("Specify the fixed final checkpoint")
+    meta = json.loads((resume / "complete.json").read_text())
+    if (meta["completed_epochs"] != 60 or not meta["training_complete"]
+            or meta["protocol_sha256"] != sha256(output / "protocol.json")):
+        raise ValueError("Test is allowed only after the fixed 60-epoch training")
+    from safetensors.torch import load_file
+    model, _, post = build_detector(configure(output), is_fresh_train=False)
+    model.load_state_dict(load_file(str(resume / "model.safetensors")), strict=True)
+    model.to(accelerator.device).eval()
+    data = TestImages()
+    indices = list(range(accelerator.process_index, len(data), accelerator.num_processes))
+    loader = DataLoader(Subset(data, indices), batch_size=1, num_workers=2, collate_fn=collate_fn)
+    exporter = VCOCOExport()
+    records = []
+    seen = []
+    eval_dir = output / "official_test"
+    eval_dir.mkdir(exist_ok=True)
+    with torch.inference_mode():
+        for step, (samples, targets) in enumerate(loader):
+            with accelerator.autocast():
+                predictions = model(samples.to(accelerator.device))
+            results = post["hoi"](predictions, torch.stack([t["orig_size"] for t in targets]))
+            for prediction, target in zip(results, targets):
+                records.extend(exporter(prediction, target["img_id"]))
+                seen.append(target["img_id"])
+            if step % 100 == 0:
+                print(f"test rank={accelerator.process_index} {step + 1}/{len(loader)}", flush=True)
+    shard = eval_dir / f"rank{accelerator.process_index}.pkl"
+    with shard.with_suffix(".partial").open("wb") as handle:
+        pickle.dump({"image_ids": seen, "records": records}, handle, protocol=4)
+    shard.with_suffix(".partial").replace(shard)
+    accelerator.wait_for_everyone()
+    if accelerator.is_main_process:
+        all_ids, all_records = [], []
+        for rank in range(accelerator.num_processes):
+            with (eval_dir / f"rank{rank}.pkl").open("rb") as handle:
+                part = pickle.load(handle)
+            all_ids.extend(part["image_ids"])
+            all_records.extend(part["records"])
+        assert len(all_ids) == len(set(all_ids)) == 4946 and set(all_ids) == set(data.ids)
+        prediction_file = eval_dir / "predictions.pkl"
+        with prediction_file.with_suffix(".partial").open("wb") as handle:
+            pickle.dump(all_records, handle, protocol=4)
+        prediction_file.with_suffix(".partial").replace(prediction_file)
+        atomic_json(eval_dir / "coverage.json", {"images": 4946, "image_ids": sorted(all_ids),
+                    "checkpoint": str(resume), "checkpoint_sha256": sha256(resume / "model.safetensors")})
+    accelerator.wait_for_everyone()
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--mode", required=True, choices=["prepare", "validate", "train", "test"])
+    parser.add_argument("--output", required=True, type=Path)
+    parser.add_argument("--resume", type=Path)
+    args = parser.parse_args()
+    args.output.mkdir(parents=True, exist_ok=True)
+    accelerator = Accelerator(mixed_precision="bf16", gradient_accumulation_steps=4,
+        step_scheduler_with_optimizer=False,
+        kwargs_handlers=[DistributedDataParallelKwargs(find_unused_parameters=True)])
+    set_seed(42)
+    if args.mode == "prepare":
+        prepare(args.output, accelerator)
+    elif args.mode == "validate":
+        validate(args.output, accelerator)
+    elif args.mode == "train":
+        train(args.output, accelerator, args.resume)
+    else:
+        test(args.output, accelerator, args.resume)
+
+
+if __name__ == "__main__":
+    main()
