+"""V-COCO export for native SL-HOI scores; no CoRISP modules or learned adapter.
+
+Label and null conventions follow GEN-VLKT's released V-COCO adapter.
+The class score is SL-HOI's native sigmoid(HOI) + sigmoid(noun)^2.
+"""
+
+from collections import defaultdict
+
+import numpy as np
+import torch
+
+from datasets.vcoco_text_label import vcoco_hoi_text_label
+from datasets.hico_eval_triplet import HICOEvaluator
+
+VERBS = (
+    "hold_obj", "stand", "sit_instr", "ride_instr", "walk", "look_obj",
+    "hit_instr", "hit_obj", "eat_obj", "eat_instr", "jump_instr", "lay_instr",
+    "talk_on_phone_instr", "carry_obj", "throw_obj", "catch_obj", "cut_instr",
+    "cut_obj", "run", "work_on_computer_instr", "ski_instr", "surf_instr",
+    "skateboard_instr", "smile", "drink_instr", "kick_obj", "point_instr",
+    "read_obj", "snowboard_instr",
+)
+
+
+class VCOCOExport:
+    # Reuse the upstream paired-box suppression, with the published defaults.
+    pairwise_nms = HICOEvaluator.pairwise_nms
+    thres_nms = 0.7
+    nms_alpha = 1.0
+    nms_beta = 0.5
+
+    def __init__(self):
+        self.keys = list(vcoco_hoi_text_label)
+        self.by_verb = [[i for i, (v, _) in enumerate(self.keys) if v == verb]
+                        for verb in range(len(VERBS))]
+
+    def __call__(self, prediction, image_id):
+        hoi = prediction["hoi_scores"].float().numpy()
+        noun = prediction["obj_scores"].float().numpy()
+        scores = hoi + noun[:, [n for _, n in self.keys]] ** 2
+        scores = np.stack([scores[:, indices].max(1) for indices in self.by_verb], 1)
+        labels = prediction["labels"].numpy()
+        boxes = prediction["boxes"].float().numpy()
+        subjects = prediction["sub_ids"].numpy()
+        objects = prediction["obj_ids"].numpy()
+        groups = defaultdict(list)
+        for q, obj in enumerate(objects):
+            groups[int(labels[obj])].append(q)
+        keep = []
+        for category, indices in groups.items():
+            indices = np.asarray(indices)
+            sb = boxes[subjects[indices]]
+            # A missing entity has no geometric extent. Suppress duplicates
+            # using the person box, not an unsupervised predicted entity box.
+            ob = sb if category == 80 else boxes[objects[indices]]
+            retained = self.pairwise_nms(sb, ob, scores[indices].max(1))
+            keep.extend(indices[retained].tolist())
+        records = []
+        for q in keep:
+            record = {"image_id": int(image_id), "person_box": boxes[subjects[q]].tolist()}
+            object_box = ([float("nan")] * 4 if labels[objects[q]] == 80
+                          else boxes[objects[q]].tolist())
+            for verb, score in zip(VERBS, scores[q]):
+                score = float(score)
+                if verb.endswith(("_obj", "_instr")):
+                    record[verb] = object_box + [score]
+                    agent = verb.rsplit("_", 1)[0] + "_agent"
+                    record[agent] = max(score, record.get(agent, 0.0))
+                else:
+                    record[verb + "_agent"] = score
+            records.append(record)
+        return records
+
+
+def audit_training(data, split_ids):
+    expected = {int(x) for x in split_ids.read_text().split()}
+    observed = set()
+    supported = set(vcoco_hoi_text_label)
+    null_count = 0
+    role_counts = {v: 0 for v in VERBS}
+    for item in data.annotations:
+        image_id = int(item["file_name"].split("_")[-1].split(".")[0])
+        if image_id in observed:
+            raise ValueError(f"Duplicate train image {image_id}")
+        observed.add(image_id)
+        if not (data.img_folder / item["file_name"]).is_file():
+            raise FileNotFoundError(item["file_name"])
+        for edge in item["hoi_annotation"]:
+            subject, obj, verb = edge["subject_id"], edge["object_id"], edge["category_id"]
+            if item["annotations"][subject]["category_id"] != 1:
+                raise ValueError("Non-human V-COCO subject")
+            noun = 80 if obj == -1 else data._valid_obj_ids.index(item["annotations"][obj]["category_id"])
+            if (verb, noun) not in supported:
+                raise ValueError(f"Unmapped training class {(verb, noun)}")
+            null_count += obj == -1
+            role_counts[VERBS[verb]] += 1
+    if observed != expected or len(observed) != 5400:
+        raise ValueError("Training images do not match the official 5400-image trainval split")
+    return {"images": len(observed), "missing_entity_edges": null_count,
+            "role_counts": role_counts, "hoi_classes": len(supported),
+            "entity_null_class": 80, "background_class": 81,
+            "test_annotations_read": False}
