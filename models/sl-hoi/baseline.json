{
  "assets": {
    "DINO_WEIGHTS": {
      "mounts": [
        [
          "workspace/third_party/SL-HOI/weights/dinov3",
          ""
        ]
      ],
      "sha256": {}
    },
    "VCOCO": {
      "mounts": [
        [
          "data/v-coco",
          ""
        ]
      ],
      "sha256": {}
    }
  },
  "commands": {
    "sources": {
      "argv": [
        "{python}",
        "{root}/workspace/fetch_sources.py"
      ],
      "assets": [],
      "cwd": "{root}/workspace",
      "distributed": false,
      "run_name": "sources",
      "world_size": 1,
      "pythonpath": [
        "workspace"
      ]
    },
    "prepare": {
      "argv": [
        "{python}",
        "run_vcoco.py",
        "--mode",
        "prepare",
        "--output",
        "{output}"
      ],
      "assets": [
        "VCOCO",
        "DINO_WEIGHTS"
      ],
      "cwd": "{root}/workspace/reference_repos/SL-HOI",
      "distributed": false,
      "run_name": "slhoi",
      "world_size": 1
    },
    "score": {
      "argv": [
        "{python}",
        "{root}/workspace/vcoco_eval/scripts/evaluate_vcoco_official.py",
        "--cache",
        "{output}/official_test/predictions.pkl",
        "--vsrl-json",
        "{root}/data/v-coco/data/vcoco/vcoco_test.json",
        "--coco-json",
        "{root}/data/v-coco/data/instances_vcoco_all_2014.json",
        "--split-ids",
        "{root}/data/v-coco/data/splits/vcoco_test.ids",
        "--evaluator",
        "{root}/data/v-coco/vsrl_eval.py",
        "--output-json",
        "{output}/official_metrics.json",
        "--agent-ap"
      ],
      "assets": [
        "VCOCO"
      ],
      "cwd": "{root}/workspace",
      "distributed": false,
      "run_name": "slhoi",
      "world_size": 1
    },
    "test": {
      "argv": [
        "{python}",
        "run_vcoco.py",
        "--mode",
        "test",
        "--output",
        "{output}",
        "--resume",
        "{output}/checkpoint-epoch-060"
      ],
      "assets": [
        "VCOCO",
        "DINO_WEIGHTS"
      ],
      "cwd": "{root}/workspace/reference_repos/SL-HOI",
      "distributed": true,
      "run_name": "slhoi",
      "world_size": 8
    },
    "train": {
      "argv": [
        "{python}",
        "run_vcoco.py",
        "--mode",
        "train",
        "--output",
        "{output}"
      ],
      "assets": [
        "VCOCO",
        "DINO_WEIGHTS"
      ],
      "cwd": "{root}/workspace/reference_repos/SL-HOI",
      "distributed": true,
      "run_name": "slhoi",
      "world_size": 8
    },
    "validate": {
      "argv": [
        "{python}",
        "run_vcoco.py",
        "--mode",
        "validate",
        "--output",
        "{output}"
      ],
      "assets": [
        "VCOCO",
        "DINO_WEIGHTS"
      ],
      "cwd": "{root}/workspace/reference_repos/SL-HOI",
      "distributed": false,
      "run_name": "slhoi",
      "world_size": 1
    }
  },
  "family": "sl-hoi"
}
