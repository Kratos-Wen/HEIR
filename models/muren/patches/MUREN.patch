@@ -0,0 +1,40 @@
+"""HEIR v1.0 in HICO-DET layout (converted by common/convert_heir_to_hico.py).
+
+Identical to MUREN's HICODetection (same targets, same DETR augmentations, same
+per-pair multi-label interaction vectors) except the label spaces: object ids are
+already contiguous 0..436 (person = 0) and interaction ids contiguous 0..224, so
+the id -> index maps are the identity.
+"""
+from pathlib import Path
+import json
+
+import numpy as np
+
+from .hico import HICODetection, make_hico_transforms
+
+NUM_OBJ = 437
+NUM_INTER = 225
+
+
+class HEIRDetection(HICODetection):
+    def __init__(self, img_set, img_folder, anno_file, transforms, num_queries, args=None):
+        super().__init__(img_set, img_folder, anno_file, transforms, num_queries, args=args)
+        self._valid_obj_ids = list(range(NUM_OBJ))
+        self._valid_verb_ids = list(range(NUM_INTER))
+
+
+def build(image_set, args):
+    root = Path(args.hoi_path)
+    assert root.exists(), f'provided HOI path {root} does not exist'
+    assert args.num_obj_classes == NUM_OBJ and args.num_verb_classes == NUM_INTER, \
+        'HEIR needs --num_obj_classes 437 --num_verb_classes 225'
+    split = {'train': 'train', 'val': 'val', 'test': 'test'}[image_set]
+    anno_file = root / 'annotations' / f'{split}_heir.json'
+    # train uses the full DETR augmentation pipeline; val/test use the HICO eval transform
+    transforms = make_hico_transforms('train' if image_set == 'train' else 'val')
+    dataset = HEIRDetection('train' if image_set == 'train' else 'val', root / 'images', anno_file,
+                            transforms=transforms, num_queries=args.num_queries, args=args)
+    if image_set != 'train':
+        # corre_heir.npy is [num_obj, num_inter]; MUREN's HICO evaluator indexes correct_mat[verb, obj]
+        dataset.correct_mat = np.load(root / 'annotations' / 'corre_heir.npy').T.astype(np.float32)
+    return dataset
