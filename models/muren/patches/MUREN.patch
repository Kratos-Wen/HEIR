diff --git a/tools/convert_detr_to_muren.py b/tools/convert_detr_to_muren.py
new file mode 100644
index 0000000..c0227dd
--- /dev/null
+++ b/tools/convert_detr_to_muren.py
@@ -0,0 +1,49 @@
+"""Convert COCO-pretrained DETR-R50 into MUREN's three-branch layout for HEIR.
+
+Follows QPIC/CDN's convert_parameters.py ("2stage" variant used for MUREN's
+detr-r50-pre-2stage-nq64.pth): backbone, input_proj and encoder copied as is;
+DETR's decoder (layers + final norm) copied into each of MUREN's three branch
+decoders (human / object / relation); the first num_queries rows of DETR's
+query_embed initialise all three query embeddings; DETR's bbox_embed initialises
+both sub_bbox_embed and obj_bbox_embed. The object classifier is NOT copied:
+HEIR has 437 object classes (vs COCO 91), so obj_class_embed keeps its random
+init (loaded with strict=False). MURE / ATF modules are new (random init) as in
+the official recipe.
+"""
+import argparse
+import torch
+
+ap = argparse.ArgumentParser()
+ap.add_argument('--load_path', required=True)
+ap.add_argument('--save_path', required=True)
+ap.add_argument('--num_queries', type=int, default=64)
+ap.add_argument('--dec_layers', type=int, default=6)
+a = ap.parse_args()
+
+src = torch.load(a.load_path, map_location='cpu')['model']
+out = {}
+for k, v in src.items():
+    if k.startswith('backbone.') or k.startswith('input_proj.') or k.startswith('transformer.encoder.'):
+        out[k] = v.clone()
+    elif k.startswith('transformer.decoder.layers.'):
+        rest = k[len('transformer.decoder.layers.'):]
+        assert int(rest.split('.')[0]) < a.dec_layers
+        for br in ('human', 'obj', 'rel'):
+            out[f'transformer.decoder.layers_{br}.{rest}'] = v.clone()
+    elif k.startswith('transformer.decoder.norm.'):
+        rest = k[len('transformer.decoder.norm.'):]
+        for br in ('human', 'obj', 'rel'):
+            out[f'transformer.decoder.norm_{br}.{rest}'] = v.clone()
+    elif k == 'query_embed.weight':
+        for br in ('human', 'obj', 'rel'):
+            out[f'query_embed_{br}.weight'] = v[:a.num_queries].clone()
+    elif k.startswith('bbox_embed.'):
+        rest = k[len('bbox_embed.'):]
+        out['sub_bbox_embed.' + rest] = v.clone()
+        out['obj_bbox_embed.' + rest] = v.clone()
+    elif k.startswith('class_embed.'):
+        continue  # re-initialised for 437 HEIR objects
+    else:
+        raise KeyError(f'unexpected DETR key {k}')
+torch.save({'model': out}, a.save_path)
+print(f'saved {len(out)} tensors to {a.save_path}')
diff --git a/tools/export_heir_predictions.py b/tools/export_heir_predictions.py
new file mode 100644
index 0000000..14639de
--- /dev/null
+++ b/tools/export_heir_predictions.py
@@ -0,0 +1,109 @@
+"""Export MUREN predictions on a HEIR split to the shared JSONL format.
+
+Post-processing is MUREN's HICO-DET evaluation path, unchanged:
+  PostProcessHOI: obj_score = max softmax over the 437 real classes, interaction
+  score = sigmoid(verb logit) * obj_score (per query pair, 64 pairs x 225 classes);
+  boxes = 64 subject boxes (label person=0) + 64 object boxes, in original pixels.
+  HICOEvaluator: score *= correct_mat[interaction, obj_label] (corre_heir.npy),
+  keep top-100 per image, then triplet pair-NMS (--use_nms_filter as in the
+  official HICO eval command; thres 0.6, alpha 0.7, beta 0.7 = MUREN defaults).
+box_scores: MUREN has no separate subject confidence; subject box i and object
+box i both get obj_score of query i (the pair confidence).
+"""
+import argparse, json, sys
+from pathlib import Path
+
+import numpy as np
+import torch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+import main as muren_main  # noqa: E402
+import util.misc as utils  # noqa: E402
+from datasets import build_dataset  # noqa: E402
+from datasets.hico_eval import HICOEvaluator  # noqa: E402  (only its NMS methods are used)
+from models import build_model  # noqa: E402
+
+
+class _NMS(HICOEvaluator):
+    def __init__(self, args):  # skip the evaluator's heavy constructor
+        self.thres_nms, self.nms_alpha, self.nms_beta = args.thres_nms, args.nms_alpha, args.nms_beta
+
+
+def main():
+    parser = argparse.ArgumentParser(parents=[muren_main.get_args_parser()])
+    parser.add_argument('--checkpoint', required=True)
+    parser.add_argument('--split', choices=('val', 'test'), required=True)
+    parser.add_argument('--predictions', required=True)
+    parser.add_argument('--max_images', type=int, default=0, help='smoke: only run the first N images, rest empty')
+    parser.add_argument('--max_hois', type=int, default=100)
+    parser.add_argument('--correct_mat_path', default='',
+                        help='bool [437 obj, 225 inter] mask replacing corre_heir.npy (e.g. corre_semantic10072.npy)')
+    args = parser.parse_args()
+    args.distributed = False
+    device = torch.device(args.device)
+
+    model, _, post = build_model(args)
+    ck = torch.load(args.checkpoint, map_location='cpu', weights_only=False)
+    model.load_state_dict(ck['model'])
+    model.to(device).eval()
+    print('loaded', args.checkpoint, 'epoch', ck.get('epoch'))
+
+    ds = build_dataset(args.split, args)
+    records = ds.annotations
+    assert ds.ids == list(range(len(records)))
+    n_run = len(ds) if args.max_images <= 0 else min(args.max_images, len(ds))
+    sub = torch.utils.data.Subset(ds, list(range(n_run)))
+    dl = torch.utils.data.DataLoader(sub, batch_size=args.batch_size, shuffle=False,
+                                     collate_fn=utils.collate_fn, num_workers=args.num_workers)
+    correct_mat = ds.correct_mat  # [225, 437]
+    if args.correct_mat_path:  # same transpose as corre_heir.npy in datasets/heir.py
+        m = np.load(args.correct_mat_path)
+        assert m.shape == (437, 225) and m.dtype == bool, (m.shape, m.dtype)
+        correct_mat = m.T.astype(np.float32)
+        print('correct_mat from', args.correct_mat_path, 'allowed', int(m.sum()))
+    nms = _NMS(args)
+    out_lines = []
+    idx = 0
+    with torch.no_grad():
+        for samples, targets in dl:
+            outputs = model(samples.to(device))
+            sizes = torch.stack([t['orig_size'] for t in targets]).to(device)
+            results = post['hoi'](outputs, sizes)
+            for res, tgt in zip(results, targets):
+                assert int(tgt['id']) == idx
+                boxes = res['boxes'].numpy()
+                labels = res['labels'].numpy()
+                obj_scores = res['obj_scores'].numpy()
+                vs = res['verb_scores'].numpy()  # [Q, 225]
+                q, c = vs.shape
+                sub_ids = np.repeat(res['sub_ids'].numpy(), c)
+                obj_ids = np.repeat(res['obj_ids'].numpy(), c)
+                cats = np.tile(np.arange(c), q)
+                scores = vs.ravel() * correct_mat[cats, labels[obj_ids]]
+                order = np.argsort(-scores, kind='stable')[:args.max_hois]
+                hois = [{'subject_id': int(sub_ids[i]), 'object_id': int(obj_ids[i]),
+                         'category_id': int(cats[i]), 'score': float(scores[i])} for i in order]
+                if args.use_nms_filter and hois:
+                    bb = [{'bbox': list(b), 'category_id': int(l)} for b, l in zip(boxes, labels)]
+                    hois = nms.triplet_nms_filter([{'filename': '', 'predictions': bb,
+                                                    'hoi_prediction': hois}])[0]['hoi_prediction']
+                    hois = [dict(h) for h in hois]
+                box_scores = np.concatenate([obj_scores, obj_scores])
+                out_lines.append({'image_id': str(records[idx]['image_id']),
+                                  'boxes': [[float(x) for x in b] for b in boxes],
+                                  'labels': [int(l) for l in labels],
+                                  'box_scores': [float(s) for s in box_scores], 'hois': hois})
+                idx += 1
+            print(f'{idx}/{n_run}', flush=True)
+    for j in range(idx, len(records)):
+        out_lines.append({'image_id': str(records[j]['image_id']), 'boxes': [], 'labels': [],
+                          'box_scores': [], 'hois': []})
+    Path(args.predictions).parent.mkdir(parents=True, exist_ok=True)
+    with open(args.predictions, 'w') as f:
+        for r in out_lines:
+            f.write(json.dumps(r) + '\n')
+    print('wrote', len(out_lines), 'lines to', args.predictions)
+
+
+if __name__ == '__main__':
+    main()
