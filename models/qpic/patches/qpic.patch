+"""HEIR v1.0 in HICO-DET layout (converted by common/convert_heir_to_hico.py).
+
+Same loader/targets/augmentations as QPIC's HICODetection; only the class id tables and paths differ:
+object ids are already contiguous 0..436 (person = 0), interaction ids contiguous 0..224.
+Train uses train_heir.json only; 'val' (per-epoch monitoring) = val_heir.json; 'test' = test_heir.json
+(inference/export only).
+"""
+from pathlib import Path
+import numpy as np
+
+from .hico import HICODetection, make_hico_transforms
+
+NUM_OBJ, NUM_VERB = 437, 225
+
+
+class HEIRDetection(HICODetection):
+    def __init__(self, img_set, img_folder, anno_file, transforms, num_queries):
+        super().__init__(img_set, img_folder, anno_file, transforms, num_queries)
+        self._valid_obj_ids = tuple(range(NUM_OBJ))
+        self._valid_verb_ids = list(range(NUM_VERB))
+
+    def load_correct_mat(self, path):
+        # corre_heir.npy is [object, interaction]; QPIC indexes correct_mat[verb, object] (HICO layout).
+        m = np.load(path)
+        assert m.shape == (NUM_OBJ, NUM_VERB), m.shape
+        self.correct_mat = m.T.astype(np.float32)
+
+
+def build(image_set, args):
+    root = Path(args.hoi_path)
+    assert root.exists(), f'provided HOI path {root} does not exist'
+    ann = root / 'annotations'
+    PATHS = {'train': ann / 'train_heir.json', 'val': ann / 'val_heir.json', 'test': ann / 'test_heir.json'}
+    tf = make_hico_transforms('train' if image_set == 'train' else 'val')
+    mode = 'train' if image_set == 'train' else 'val'
+    dataset = HEIRDetection(mode, root / 'images', PATHS[image_set], transforms=tf, num_queries=args.num_queries)
+    if image_set != 'train':
+        dataset.set_rare_hois(PATHS['train'])
+        dataset.load_correct_mat(ann / 'corre_heir.npy')
+    return dataset
