diff --git a/export_heir.py b/export_heir.py
new file mode 100644
index 0000000..c2d7047
--- /dev/null
+++ b/export_heir.py
@@ -0,0 +1,106 @@
+"""Export QPIC predictions on HEIR val/test to the shared-scorer JSONL format.
+
+Post-processing = QPIC's PostProcessHOI + HICOEvaluator prediction path:
+  obj_prob = softmax(obj_logits)[:-1]; obj_score, obj_label = max
+  hoi score(q, v) = sigmoid(verb_logit[q, v]) * obj_score[q] * correct_mat[v, obj_label[q]]
+  keep the top 100 (QPIC max_hois) triplets per image; boxes rescaled to original pixels.
+Boxes: only subject/object boxes referenced by kept triplets are written (re-indexed); subject label = person (0).
+box_scores: object box = its query's object score; subject box = the same query's object score (QPIC has no
+separate subject confidence).
+"""
+import argparse, json, sys, time
+from pathlib import Path
+import numpy as np
+import torch
+from torch.utils.data import DataLoader, SequentialSampler
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import util.misc as utils
+from datasets.heir import build as build_heir
+from models import build_model
+from util.box_ops import box_cxcywh_to_xyxy
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--checkpoint', required=True)
+    ap.add_argument('--split', choices=('val', 'test'), required=True)
+    ap.add_argument('--output', required=True)
+    ap.add_argument('--hoi_path', required=True)
+    ap.add_argument('--limit', type=int, default=0, help='only run the first N images; others get empty predictions')
+    ap.add_argument('--top_k', type=int, default=100)
+    ap.add_argument('--batch_size', type=int, default=4)
+    ap.add_argument('--num_workers', type=int, default=4)
+    ap.add_argument('--correct_mat', default='', help='override co-occurrence mask: bool [437 objects, 225 interactions] .npy '
+                    '(same layout as corre_heir.npy); default = corre_heir.npy')
+    a = ap.parse_args()
+
+    ck = torch.load(a.checkpoint, map_location='cpu', weights_only=False)
+    args = ck['args']
+    args.hoi_path = a.hoi_path
+    args.distributed = False
+    device = torch.device('cuda')
+    model, _, _ = build_model(args)
+    print(model.load_state_dict(ck['model']))
+    model.to(device).eval()
+
+    ds = build_heir(a.split, args)
+    if a.correct_mat:
+        m = np.load(a.correct_mat)
+        assert m.shape == (437, 225), m.shape
+        ds.correct_mat = m.T.astype(np.float32)  # same transpose as HEIRDetection.load_correct_mat
+        print('correct_mat override:', a.correct_mat, 'allowed =', int(m.sum()))
+    correct = torch.from_numpy(ds.correct_mat).to(device)  # [V, O]
+    n = len(ds) if not a.limit else min(a.limit, len(ds))
+    sub = torch.utils.data.Subset(ds, list(range(n)))
+    dl = DataLoader(sub, a.batch_size, sampler=SequentialSampler(sub), collate_fn=utils.collate_fn,
+                    num_workers=a.num_workers)
+    recs = {}
+    mismatched = 0
+    t0 = time.time()
+    with torch.no_grad():
+        for samples, targets in dl:
+            out = model(samples.to(device))
+            obj_prob = out['pred_obj_logits'].softmax(-1)[..., :-1]
+            obj_scores, obj_labels = obj_prob.max(-1)                        # [B, Q]
+            verb = out['pred_verb_logits'].sigmoid() * obj_scores[..., None]  # [B, Q, V]
+            verb = verb * correct[:, obj_labels].permute(1, 2, 0)            # mask[v, label[b,q]] -> [B,Q,V]
+            for b, t in enumerate(targets):
+                idx = int(t['id'])
+                anno = ds.annotations[idx]
+                h, w = [int(x) for x in t['orig_size']]
+                if (w, h) != (anno['width'], anno['height']):
+                    mismatched += 1
+                scale = torch.tensor([w, h, w, h], dtype=torch.float32, device=device)
+                sb = box_cxcywh_to_xyxy(out['pred_sub_boxes'][b]) * scale
+                ob = box_cxcywh_to_xyxy(out['pred_obj_boxes'][b]) * scale
+                vs = verb[b].flatten()
+                k = min(a.top_k, vs.numel())
+                sc, flat = vs.topk(k)
+                keep = sc > 0
+                sc, flat = sc[keep].tolist(), flat[keep]
+                qs = (flat // verb.shape[-1]).tolist()
+                vids = (flat % verb.shape[-1]).tolist()
+                boxes, labels, bscores, hois, sub_map, obj_map = [], [], [], [], {}, {}
+                for s, q, v in zip(sc, qs, vids):
+                    if q not in sub_map:
+                        sub_map[q] = len(boxes)
+                        boxes.append(sb[q].tolist()); labels.append(0); bscores.append(float(obj_scores[b, q]))
+                    if q not in obj_map:
+                        obj_map[q] = len(boxes)
+                        boxes.append(ob[q].tolist()); labels.append(int(obj_labels[b, q])); bscores.append(float(obj_scores[b, q]))
+                    hois.append({'subject_id': sub_map[q], 'object_id': obj_map[q], 'category_id': int(v), 'score': float(s)})
+                recs[idx] = {'image_id': anno['image_id'], 'boxes': [[round(x, 2) for x in bb] for bb in boxes],
+                             'labels': labels, 'box_scores': bscores, 'hois': hois}
+    Path(a.output).parent.mkdir(parents=True, exist_ok=True)
+    with open(a.output, 'w') as f:
+        for i, anno in enumerate(ds.annotations):
+            r = recs.get(i, {'image_id': anno['image_id'], 'boxes': [], 'labels': [], 'box_scores': [], 'hois': []})
+            f.write(json.dumps(r) + '\n')
+    print(json.dumps({'split': a.split, 'images': len(ds.annotations), 'predicted': len(recs),
+                      'size_mismatch_vs_json': mismatched, 'seconds': round(time.time() - t0, 1),
+                      'checkpoint': a.checkpoint, 'epoch': ck.get('epoch'), 'correct_mat': a.correct_mat or 'corre_heir.npy'}))
+
+
+if __name__ == '__main__':
+    main()
