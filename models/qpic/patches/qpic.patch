@@ -0,0 +1,57 @@
+# HEIR adaptation of QPIC's convert_parameters.py (HICO branch).
+# Same logic as the official HICO conversion: sub/obj box MLPs are copies of DETR's bbox_embed,
+# obj_class_embed is derived from DETR's class_embed. HEIR has 437 object classes (person = 0), so the
+# object head is re-initialised (nn.Linear default init, seeded) except for rows whose class also exists
+# in COCO (exact name match, e.g. person, bicycle, cup): those copy the DETR row, as QPIC does for HICO.
+# The no-object row (DETR index 91) is kept as the last row, as in the official conversion.
+import argparse, json, hashlib
+import torch
+from torch import nn
+
+COCO = {1: 'person', 2: 'bicycle', 3: 'car', 4: 'motorcycle', 5: 'airplane', 6: 'bus', 7: 'train', 8: 'truck', 9: 'boat',
+        10: 'traffic light', 11: 'fire hydrant', 13: 'stop sign', 14: 'parking meter', 15: 'bench', 16: 'bird', 17: 'cat',
+        18: 'dog', 19: 'horse', 20: 'sheep', 21: 'cow', 22: 'elephant', 23: 'bear', 24: 'zebra', 25: 'giraffe', 27: 'backpack',
+        28: 'umbrella', 31: 'handbag', 32: 'tie', 33: 'suitcase', 34: 'frisbee', 35: 'skis', 36: 'snowboard', 37: 'sports ball',
+        38: 'kite', 39: 'baseball bat', 40: 'baseball glove', 41: 'skateboard', 42: 'surfboard', 43: 'tennis racket',
+        44: 'bottle', 46: 'wine glass', 47: 'cup', 48: 'fork', 49: 'knife', 50: 'spoon', 51: 'bowl', 52: 'banana', 53: 'apple',
+        54: 'sandwich', 55: 'orange', 56: 'broccoli', 57: 'carrot', 58: 'hot dog', 59: 'pizza', 60: 'donut', 61: 'cake',
+        62: 'chair', 63: 'couch', 64: 'potted plant', 65: 'bed', 67: 'dining table', 70: 'toilet', 72: 'tv', 73: 'laptop',
+        74: 'mouse', 75: 'remote', 76: 'keyboard', 77: 'cell phone', 78: 'microwave', 79: 'oven', 80: 'toaster', 81: 'sink',
+        82: 'refrigerator', 84: 'book', 85: 'clock', 86: 'vase', 87: 'scissors', 88: 'teddy bear', 89: 'hair drier',
+        90: 'toothbrush'}
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--load_path', required=True)
+    ap.add_argument('--save_path', required=True)
+    ap.add_argument('--classes', required=True)
+    ap.add_argument('--seed', type=int, default=42)
+    a = ap.parse_args()
+    objects = json.load(open(a.classes))['objects']
+    assert objects[0] == 'person' and len(objects) == 437
+    ps = torch.load(a.load_path, map_location='cpu', weights_only=False)
+    m = ps['model']
+    for part in ('sub', 'obj'):
+        for k in ('layers.0.weight', 'layers.0.bias', 'layers.1.weight', 'layers.1.bias', 'layers.2.weight', 'layers.2.bias'):
+            m[f'{part}_bbox_embed.{k}'] = m[f'bbox_embed.{k}'].clone()
+    torch.manual_seed(a.seed)
+    lin = nn.Linear(m['class_embed.weight'].shape[1], len(objects) + 1)
+    w, b = lin.weight.data.clone(), lin.bias.data.clone()
+    name2coco = {v: k for k, v in COCO.items()}
+    copied = {}
+    for i, n in enumerate(objects):
+        if n in name2coco:
+            w[i] = m['class_embed.weight'][name2coco[n]]
+            b[i] = m['class_embed.bias'][name2coco[n]]
+            copied[n] = name2coco[n]
+    w[-1] = m['class_embed.weight'][91]
+    b[-1] = m['class_embed.bias'][91]
+    m['obj_class_embed.weight'], m['obj_class_embed.bias'] = w, b
+    torch.save(ps, a.save_path)
+    print(json.dumps({'copied_from_coco': copied, 'num_copied': len(copied), 'num_reinit': len(objects) - len(copied),
+                      'sha256': hashlib.sha256(open(a.save_path, 'rb').read()).hexdigest()}))
+
+
+if __name__ == '__main__':
+    main()
