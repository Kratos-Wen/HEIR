      "sha256": {}
    }
  },
  "commands": {
    "sources": {
      "argv": [
        "{python}",
        "{root}/workspace/fetch_sources.py"
      ],
      "assets": [],
      "cwd": "{root}/workspace",
      "distributed": false,
      "run_name": "sources",
      "world_size": 1,
      "pythonpath": [
        "workspace"
      ]
    },
    "qpic_r50-prepare": {
      "argv": [
        "{python}",
        "{root}/workspace/heir/tools/convert_heir_to_hico.py",
        "--heir-root",
        "{root}/data/heir",
        "--out",
        "{output}/heir_hico"
      ],
      "assets": [
        "HEIR"
      ],
      "cwd": "{root}/workspace",
      "distributed": false,
      "run_name": "qpic_r50",
      "world_size": 1,
      "pythonpath": [
        "workspace/heir/scorer"
      ]
    },
    "qpic_r50-support": {
      "argv": [
        "{python}",
        "{root}/workspace/heir/tools/build_support_mask.py",
        "--support-csv",
        "{root}/data/heir_support.csv",
        "--classes",
        "{output}/heir_hico/annotations/classes.json",
        "--out",
        "{output}/support_mask.npy"
      ],
      "assets": [
        "HEIR_SUPPORT"
      ],
      "cwd": "{root}/workspace",
      "distributed": false,
      "run_name": "qpic_r50",
      "world_size": 1,
      "pythonpath": [
        "workspace/heir/scorer"
      ]
    },
    "qpic_r50-init": {
      "argv": [
        "{python}",
        "convert_parameters_heir.py",
        "--load_path",
        "{root}/assets/detr/detr-r50-e632da11.pth",
        "--save_path",
        "{output}/init.pth",
        "--classes",
        "{output}/heir_hico/annotations/classes.json"
      ],
      "assets": [
        "DETR_R50"
      ],
      "cwd": "{root}/workspace/reference_repos/qpic",
      "distributed": false,
      "run_name": "qpic_r50",
      "world_size": 1
    },
    "qpic_r50-train": {
      "argv": [
        "{python}",
        "main.py",
        "--pretrained",
        "{output}/init.pth",
        "--output_dir",
        "{output}/train",
        "--hoi",
        "--dataset_file",
        "heir",
        "--hoi_path",
        "{output}/heir_hico",
        "--num_obj_classes",
        "437",
        "--num_verb_classes",
        "225",
        "--backbone",
        "resnet50",
        "--set_cost_bbox",
        "2.5",
        "--set_cost_giou",
        "1",
        "--bbox_loss_coef",
        "2.5",
        "--giou_loss_coef",
        "1",
        "--epochs",
        "150",
        "--lr_drop",
        "100",
        "--lr",
        "1e-4",
        "--lr_backbone",
        "1e-5",
        "--weight_decay",
        "1e-4",
        "--clip_max_norm",
        "0.1",
        "--num_queries",
        "100",
        "--batch_size",
        "8",
        "--seed",
        "42",
        "--num_workers",
        "8",
        "--eval_interval",
        "5"
      ],
      "assets": [],
      "cwd": "{root}/workspace/reference_repos/qpic",
      "distributed": true,
      "run_name": "qpic_r50",
      "world_size": 2
    },
    "qpic_r50-export": {
      "argv": [
        "{python}",
        "export_heir.py",
        "--checkpoint",
        "{output}/train/checkpoint.pth",
        "--split",
        "test",
        "--hoi_path",
        "{output}/heir_hico",
        "--correct_mat",
        "{output}/support_mask.npy",
        "--output",
        "{output}/test_predictions.jsonl"
      ],
      "assets": [],
      "cwd": "{root}/workspace/reference_repos/qpic",
      "distributed": false,
      "run_name": "qpic_r50",
      "world_size": 1
    },
    "qpic_r50-score-role": {
      "argv": [
